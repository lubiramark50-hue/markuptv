<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MarkUptv.ViewModels"
             xmlns:converters="clr-namespace:MarkUptv.Converters"
             x:Class="MarkUptv.Pages.PlayerPage"
             x:DataType="vm:PlayerViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource DeepVoid}">
    <ContentPage.Resources>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
    </ContentPage.Resources>

    <Grid Padding="16" RowDefinitions="Auto,*">
        <VerticalStackLayout Spacing="4" Margin="0,10,0,14">
            <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="22" />
            <Label Text="Live stream playback" Style="{StaticResource SectionCaption}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Stroke="{StaticResource Primary}" Padding="0">
            <Grid>
                <toolkit:MediaElement x:Name="ChannelPlayer" Source="{Binding StreamUrl}"
                                      ShouldAutoPlay="True"
                                      ShouldShowPlaybackControls="True"
                                      ShouldKeepScreenOn="True"
                                      IsVisible="{Binding HasStream}" />

                <VerticalStackLayout IsVisible="{Binding HasStream, Converter={StaticResource InvertBoolConverter}}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="10"
                                     Padding="24">
                    <Label Text="LIVE" TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="Select a channel to start playback."
                           TextColor="{StaticResource TextMuted}"
                           FontSize="15"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
