<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MarkUptv.Pages.LoadingPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#050814">
    <Grid>
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
            <Label Text="MarkupTV" FontSize="32" FontAttributes="Bold" TextColor="#D4AF37" HorizontalOptions="Center" />
            <ActivityIndicator IsRunning="True" Color="#D4AF37" HorizontalOptions="Center" />
            <Label Text="Authenticating device..." TextColor="White" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>