<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarkUptv.ViewModels"
             xmlns:models="clr-namespace:MarkUptv.Models"
             x:Class="MarkUptv.Pages.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications"
             BackgroundColor="{StaticResource DeepVoid}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mark read" Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}" RefreshColor="{StaticResource Primary}">
        <CollectionView ItemsSource="{Binding Notifications}" SelectionMode="None" Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Notification">
                    <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
                            <Border BackgroundColor="#1AFF3D6E" Stroke="{StaticResource Primary}" StrokeShape="RoundRectangle 8" WidthRequest="42" HeightRequest="42">
                                <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="15" />
                                <Label Text="{Binding Body}" Style="{StaticResource SectionCaption}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding TimeAgo}" TextColor="{StaticResource NeonCyan}" FontSize="11" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="No notifications" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />
                    <Label Text="You are all caught up." Style="{StaticResource SectionCaption}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>
</ContentPage>
