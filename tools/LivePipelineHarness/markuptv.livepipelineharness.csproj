<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MarkUptv.LivePipelineHarness</AssemblyName>
    <RootNamespace>MarkUptv.LivePipelineHarness</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiles the REAL production sources, not copies. -->
    <Compile Include="..\..\MarkUptv\Models\LiveSource.cs" Link="Production\LiveSource.cs" />
    <Compile Include="..\..\MarkUptv\Models\CommunityModels.cs" Link="Production\CommunityModels.cs" />
    <Compile Include="..\..\MarkUptv\Services\ILiveCatalogProvider.cs" Link="Production\ILiveCatalogProvider.cs" />
    <Compile Include="..\..\MarkUptv\Services\LiveCatalogService.cs" Link="Production\LiveCatalogService.cs" />
    <Compile Include="..\..\MarkUptv\Services\StreamProbeService.cs" Link="Production\StreamProbeService.cs" />
    <Compile Include="..\..\MarkUptv\Services\LiveResolutionService.cs" Link="Production\LiveResolutionService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
