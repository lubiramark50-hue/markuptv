<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#E8B54A</Color>
    <Color x:Key="PrimaryDark">#7A5A18</Color>
    <Color x:Key="PrimaryDarkText">#1A1406</Color>
    <Color x:Key="Secondary">#F2C879</Color>
    <Color x:Key="SecondaryDarkText">#2A1F08</Color>
    <Color x:Key="Tertiary">#B4882C</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#B3123F</Color>
    <Color x:Key="MidnightBlue">#10162B</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="DeepVoid">#0B0E1A</Color>
    <Color x:Key="NightPanel">#111827</Color>
    <Color x:Key="NightPanelRaised">#172033</Color>
    <Color x:Key="GlassPanel">#1AFFFFFF</Color>
    <Color x:Key="GlassStroke">#3A465F</Color>
    <Color x:Key="TextLight">#EEF3FB</Color>
    <Color x:Key="TextMuted">#9AA7C2</Color>
    <!--
        Accent ramp. The names must describe the hue they hold: NeonPink used
        to be declared as "the same value as Primary" and NeonBlue as a teal,
        so any screen that asked for a pink accent silently rendered the
        primary accent instead. These values match the brand ramp the pages
        already use for their pink accents ({StaticResource AccentPink}).
    -->
    <Color x:Key="NeonPink">{StaticResource AccentPink}</Color>
    <Color x:Key="NeonBlue">#8FD8D0</Color>
    <Color x:Key="NeonCyan">#B8E6DF</Color>
    <Color x:Key="NeonAmber">#E8B54A</Color>
    <Color x:Key="SignalGreen">#6DFF8F</Color>

    <!--
        Semantic tokens for the two values the pages hard-coded most often and
        the dictionary had no name for: the dim explanatory grey and the brand
        accent pink. Adding them means new work has a token to reach for
        instead of inventing another near-identical hex.
    -->
    <Color x:Key="TextDim">#A0A0B0</Color>
    <Color x:Key="AccentPink">#FF4D8D</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="DeepVoidBrush" Color="{StaticResource DeepVoid}"/>
    <SolidColorBrush x:Key="NightPanelBrush" Color="{StaticResource NightPanel}"/>
    <SolidColorBrush x:Key="NightPanelRaisedBrush" Color="{StaticResource NightPanelRaised}"/>
    <SolidColorBrush x:Key="GlassPanelBrush" Color="{StaticResource GlassPanel}"/>
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="{StaticResource GlassStroke}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLight}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
