<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarkUptv.ViewModels"
             xmlns:models="clr-namespace:MarkUptv.Models"
             x:Class="MarkUptv.Pages.PostDetailPage"
             x:DataType="vm:PostDetailViewModel"
             Title="Discussion"
             BackgroundColor="{StaticResource DeepVoid}">
    <Grid RowDefinitions="*,Auto" Padding="16">
        <CollectionView ItemsSource="{Binding Comments}" SelectionMode="None">
            <CollectionView.Header>
                <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Item.Title}" Style="{StaticResource SectionTitle}" FontSize="22" />
                        <Label Text="{Binding Item.Description}" Style="{StaticResource SectionCaption}" LineBreakMode="WordWrap" />
                        <HorizontalStackLayout Spacing="16">
                            <Label Text="{Binding Item.LikeCount, StringFormat='Likes {0}'}" TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding Item.CommentCount, StringFormat='Comments {0}'}" TextColor="{StaticResource NeonCyan}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:UserComment">
                    <Border Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Initials}" TextColor="{StaticResource NeonAmber}" FontAttributes="Bold" />
                                <Label Text="{Binding Username}" TextColor="{StaticResource TextLight}" FontAttributes="Bold" />
                                <Label Text="{Binding TimeAgo}" TextColor="{StaticResource TextMuted}" FontSize="11" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Text}" TextColor="{StaticResource TextLight}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No comments yet." Style="{StaticResource SectionCaption}" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
        </CollectionView>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry Text="{Binding NewCommentText}" Placeholder="Add a comment..." />
                <Button Grid.Column="1" Text="Send" Style="{StaticResource AccentButton}" Command="{Binding PostCommentCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
