<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:Toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarkUptv.ViewModels"
             xmlns:converters="clr-namespace:MarkUptv.Converters"
             xmlns:models="clr-namespace:MarkUptv.Models"
             xmlns:helpers="clr-namespace:MarkUptv.Helpers"
             x:Class="MarkUptv.Pages.EuropeanSportsPage"
             xmlns:views="clr-namespace:MarkUptv.Views"
             x:DataType="vm:EuropeanSportsViewModel"
             Title="European Sports"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0E1A" Offset="0.0"/>
            <GradientStop Color="#141B33" Offset="0.5"/>
            <GradientStop Color="#070A12" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <!-- Converters -->
        <helpers:InvertBoolConverter x:Key="InvertBoolConverter" />
        <helpers:StringNullOrEmptyConverter x:Key="StringNullOrEmptyConverter" />
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        <converters:ChannelSubtitleConverter x:Key="ChannelSubtitleConverter" />
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" Padding="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Property="RowDefinitions" Value="Auto,Auto,*" />
                        <Setter Property="ColumnDefinitions" Value="*" />
                        <Setter TargetName="PlayerPanel" Property="Grid.Row" Value="0" />
                        <Setter TargetName="PlayerPanel" Property="Grid.Column" Value="0" />
                        <!-- The channel panel must sit in the star row: it sizes
                             itself internally with a '*' for the channel list,
                             and a '*' inside an Auto parent row collapses to
                             zero height - which left phones showing the group
                             chips but no channels at all. -->
                        <Setter TargetName="ChannelPanel" Property="Grid.Row" Value="2" />
                        <Setter TargetName="ChannelPanel" Property="Grid.Column" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Property="RowDefinitions" Value="*" />
                        <Setter Property="ColumnDefinitions" Value="2.5*,1.5*" />
                        <Setter TargetName="PlayerPanel" Property="Grid.Row" Value="0" />
                        <Setter TargetName="PlayerPanel" Property="Grid.Column" Value="0" />
                        <Setter TargetName="PlayerPanel" Property="Margin" Value="0,0,16,0" />
                        <Setter TargetName="ChannelPanel" Property="Grid.Row" Value="0" />
                        <Setter TargetName="ChannelPanel" Property="Grid.Column" Value="1" />
                        <Setter TargetName="ChannelPanel" Property="Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- ==================== PLAYER PANEL ==================== -->
        <Grid x:Name="PlayerPanel" RowDefinitions="Auto,*" Margin="0,0,0,12">
            <!-- Now Playing bar -->
            <Border Grid.Row="0" BackgroundColor="#1AFFFFFF" StrokeShape="RoundRectangle 8"
                    Padding="16,10" Stroke="Transparent" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*">
                    <Ellipse Grid.Column="0" Fill="#E8B54A" WidthRequest="8" HeightRequest="8" 
                             VerticalOptions="Center" Margin="0,0,10,0"
                             IsVisible="{Binding IsPlayerVisible}" />
                    <Label Grid.Column="1" Text="{Binding NowPlayingText, TargetNullValue='No match selected'}" 
                           FontSize="16" FontAttributes="Bold" TextTransform="Uppercase"
                           TextColor="White" VerticalOptions="Center" CharacterSpacing="1" />
                </Grid>
            </Border>

            <!-- Media Player -->
            <Border Grid.Row="1" BackgroundColor="#030E1A" StrokeShape="RoundRectangle 12"
                    Padding="0" Stroke="#E8B54A" StrokeThickness="1">
                <Grid>
                    <Toolkit:MediaElement x:Name="ChannelPlayer"
                                      Source="{Binding SelectedChannel.Url ,FallbackValue=''}"
                                          ShouldAutoPlay="True"
                                          ShouldShowPlaybackControls="True"
                                          ShouldKeepScreenOn="True"
                                          IsVisible="{Binding IsPlayerVisible}"
                                          MediaOpened="OnMediaOpened"
                                          MediaFailed="OnMediaFailed" />

                    <ActivityIndicator IsRunning="{Binding IsPlayerLoading}"
                                       IsVisible="{Binding IsPlayerLoading}"
                                       Color="#E8B54A" 
                                       HeightRequest="50" WidthRequest="50"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                    </ActivityIndicator>

                    <VerticalStackLayout IsVisible="{Binding IsPlayerVisible, Converter={StaticResource InvertBoolConverter}}"
                                         VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                        <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32"
                                BackgroundColor="#143D73" Stroke="#E8B54A" StrokeThickness="2"
                                HorizontalOptions="Center">
                            <Label Text="▶" TextColor="#E8B54A" FontSize="24" 
                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="4,0,0,0"/>
                        </Border>
                        <Label Text="EUROPEAN FOOTBALL" FontSize="20" TextColor="White"
                               HorizontalOptions="Center" FontAttributes="Bold" CharacterSpacing="1.5" />
                        <Label Text="Free-to-air channels carrying European football - pick one to start streaming."
                               FontSize="14" TextColor="#A0B5A6"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== CHANNEL PANEL ==================== -->
        <Grid x:Name="ChannelPanel" RowDefinitions="Auto,Auto,Auto,*" Margin="0">
            <!-- Sync + Search -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,12">
                <Button Grid.Column="0" Text="⟳ SYNC" 
                        Command="{Binding LoadChannelsCommand}"
                        BackgroundColor="#E8B54A" TextColor="#0A1F44"
                        CornerRadius="8" HeightRequest="44" WidthRequest="90"
                        FontSize="14" FontAttributes="Bold" CharacterSpacing="1" />

                <Border Grid.Column="1" BackgroundColor="#1AFFFFFF" StrokeShape="RoundRectangle 8" Stroke="Transparent" HeightRequest="44">
                    <SearchBar Placeholder="Search sports or channels..." 
                               Text="{Binding SearchText}"
                               BackgroundColor="Transparent" TextColor="White"
                               PlaceholderColor="#A0B5A6" CancelButtonColor="#E8B54A"
                               VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Groups -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding Groups}" 
                            SelectionMode="Single"
                            SelectionChanged="OnGroupSelected" 
                            HeightRequest="40" Margin="0,0,0,12">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border StrokeShape="RoundRectangle 20" 
                                BackgroundColor="#143D73" Padding="16,0"
                                Stroke="#E8B54A" StrokeThickness="1">
                            <Label Text="{Binding .}" TextColor="#E8B54A" FontSize="13" 
                                   FontAttributes="Bold" TextTransform="Uppercase"
                                   LineBreakMode="NoWrap" MaxLines="1"
                                   VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Loading -->
            <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}" Color="#E8B54A" 
                               HeightRequest="30" Margin="0,8" />

            <!-- Channels List -->
            <RefreshView Grid.Row="3" IsRefreshing="{Binding IsLoading}" 
                         Command="{Binding LoadChannelsCommand}" RefreshColor="#E8B54A">
                <CollectionView ItemsSource="{Binding Channels}" 
                                SelectionMode="Single"
                                SelectionChanged="OnChannelSelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=2, Tablet=4, Desktop=6, TV=6}"
                                         HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TvChannel">
                            <!-- Dense 2-up tile: 8 channels per screen instead of 4. -->
                            <views:ChannelTileCard WatchClicked="OnWatchClicked"
                                                   LogoClicked="OnLogoClicked" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40">
                            <Label Text="🏆" FontSize="48" HorizontalOptions="Center" Margin="0,0,0,12" Opacity="0.5" />
                            <Label Text="NO EUROPEAN FOOTBALL CHANNELS FOUND" 
                                   TextColor="#A0B5A6" FontSize="18" FontAttributes="Bold" CharacterSpacing="1"
                                   HorizontalOptions="Center" />
                            <Label Text="Pull to refresh the channel list." 
                                   TextColor="#A0B5A6" FontSize="14" Opacity="0.8"
                                   HorizontalOptions="Center" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <!-- Error message -->
            <Border Grid.Row="3" BackgroundColor="#E63946" StrokeShape="RoundRectangle 8"
                    Padding="12,8" Margin="0,0,0,16" VerticalOptions="End" HorizontalOptions="Center"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" TextColor="White" 
                       FontAttributes="Bold" FontSize="13" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
