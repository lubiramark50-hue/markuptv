<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MarkUptv.Pages.ConnectionRequiredPage"
             Title="Connection"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="{StaticResource DeepVoid}">
    <Grid Padding="28" RowDefinitions="*,Auto,*">
        <VerticalStackLayout Grid.Row="1"
                             Spacing="16"
                             MaximumWidthRequest="460"
                             HorizontalOptions="Center">

            <Border WidthRequest="72"
                    HeightRequest="72"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{StaticResource Primary}"
                    Stroke="Transparent"
                    HorizontalOptions="Center">
                <Path Data="M12 1 L23 12 L12 23 L1 12 Z"
                      Fill="White"
                      Aspect="Uniform"
                      WidthRequest="30"
                      HeightRequest="30"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>

            <Label Text="Can't reach MarkUpTV"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextLight}"
                   HorizontalTextAlignment="Center" />

            <Label Text="Check your internet connection and try again. Your account and your access are safe."
                   FontSize="14"
                   LineHeight="1.3"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="RetryButton"
                    Text="Try again"
                    Clicked="OnRetryClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource PrimaryDarkText}"
                    CornerRadius="26"
                    HeightRequest="52"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,8,0,0"
                    SemanticProperties.Description="Try connecting again" />

            <ActivityIndicator x:Name="Spinner"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{StaticResource Primary}"
                               HeightRequest="28" />

            <Label x:Name="StatusLabel"
                   IsVisible="False"
                   FontSize="12.5"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
