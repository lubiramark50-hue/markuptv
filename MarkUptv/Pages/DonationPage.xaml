<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarkUptv.ViewModels"
             xmlns:helpers="clr-namespace:MarkUptv.Helpers"
             x:Class="MarkUptv.Pages.DonationPage"
             x:DataType="vm:DonationViewModel"
             Title="Support MarkUp"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource DeepVoid}">
    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32"
                             Spacing="18"
                             MaximumWidthRequest="520"
                             HorizontalOptions="Center">

            <VerticalStackLayout Spacing="6">
                <Label Text="Support MarkUp"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Your donation helps keep the channels free for everyone."
                       FontSize="14"
                       LineHeight="1.25"
                       TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

            <Border Padding="18"
                    BackgroundColor="{StaticResource NightPanel}"
                    Stroke="{StaticResource GlassStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Amount (UGX)" FontSize="12" TextColor="{StaticResource TextMuted}" />
                        <Border BackgroundColor="#14FFFFFF" Stroke="{StaticResource GlassStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                            <Entry Text="{Binding Amount}" Keyboard="Numeric" Placeholder="5000"
                                   PlaceholderColor="{StaticResource TextMuted}" TextColor="{StaticResource TextLight}"
                                   BackgroundColor="Transparent" FontSize="16" HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" FontSize="12" TextColor="{StaticResource TextMuted}" />
                        <Border BackgroundColor="#14FFFFFF" Stroke="{StaticResource GlassStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="name@example.com"
                                   PlaceholderColor="{StaticResource TextMuted}" TextColor="{StaticResource TextLight}"
                                   BackgroundColor="Transparent" FontSize="16" HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Phone number" FontSize="12" TextColor="{StaticResource TextMuted}" />
                        <Border BackgroundColor="#14FFFFFF" Stroke="{StaticResource GlassStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                            <Entry Text="{Binding PhoneNumber}" Keyboard="Telephone" Placeholder="0700000000"
                                   PlaceholderColor="{StaticResource TextMuted}" TextColor="{StaticResource TextLight}"
                                   BackgroundColor="Transparent" FontSize="16" HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="First name" FontSize="12" TextColor="{StaticResource TextMuted}" />
                            <Border BackgroundColor="#14FFFFFF" Stroke="{StaticResource GlassStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                                <Entry Text="{Binding FirstName}" Placeholder="First"
                                       PlaceholderColor="{StaticResource TextMuted}" TextColor="{StaticResource TextLight}"
                                       BackgroundColor="Transparent" FontSize="16" HeightRequest="48" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Last name" FontSize="12" TextColor="{StaticResource TextMuted}" />
                            <Border BackgroundColor="#14FFFFFF" Stroke="{StaticResource GlassStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                                <Entry Text="{Binding LastName}" Placeholder="Last"
                                       PlaceholderColor="{StaticResource TextMuted}" TextColor="{StaticResource TextLight}"
                                       BackgroundColor="Transparent" FontSize="16" HeightRequest="48" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding StatusMessage}"
                           FontSize="13"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="#FF8A8A"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasError}" />

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}"
                                       HeightRequest="32" />

                    <Button Text="Donate now"
                            Clicked="OnDonateClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource PrimaryDarkText}"
                            CornerRadius="26"
                            HeightRequest="52"
                            FontSize="16"
                            FontAttributes="Bold">
                        <Button.Triggers>
                            <EventTrigger Event="Clicked">
                                <helpers:BounceAnimation />
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <ActivityIndicator IsRunning="{Binding Donating}"
                                       IsEnabled="{Binding Donating}"
                                       IsVisible="{Binding Donating}"
                                       Color="{StaticResource Primary}" />

                    <Button Text="Clear error"
                            Command="{Binding ClearErrorCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextMuted}"
                            HeightRequest="48"
                            FontSize="13"
                            IsVisible="{Binding HasError}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
