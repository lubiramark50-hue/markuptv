<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MarkUptv.Pages.MorePage"
             Title="Explore more"
             BackgroundColor="{StaticResource DeepVoid}">

    <ScrollView>
        <VerticalStackLayout Spacing="20"
                             MaximumWidthRequest="720"
                             HorizontalOptions="Fill"
                             Padding="{OnIdiom Phone='18,24,18,36', Tablet='26,32,26,42', Desktop='36,36,36,48', TV='48,44,48,56'}">

            <VerticalStackLayout Spacing="7">
                <Label Text="MARKUPTV"
                       FontSize="11"
                       CharacterSpacing="2.4"
                       FontAttributes="Bold"
                       TextColor="#E8B54A" />
                <Label Text="Explore more"
                       FontSize="{OnIdiom Phone=29, Tablet=34, Desktop=38, TV=42}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextLight}" />
                <Label Text="Your viewing history, people and stories — one place to return to."
                       FontSize="14"
                       TextColor="{StaticResource TextMuted}"
                       LineHeight="1.4"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Border BackgroundColor="#141D30"
                    Stroke="#34415C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="18">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                    <Border WidthRequest="60" HeightRequest="60"
                            BackgroundColor="#28304B"
                            Stroke="#78613A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            VerticalOptions="Center">
                        <Label Text="▶"
                               FontSize="20"
                               TextColor="#E8B54A"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                        <Label Text="Keep discovering"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextLight}" />
                        <Label Text="Pick up where you left off, or explore something new."
                               FontSize="13"
                               TextColor="{StaticResource TextMuted}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="12">
                <Label Text="QUICK ACCESS"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       TextColor="#E8B54A" />

                <Border BackgroundColor="{StaticResource NightPanel}"
                        Stroke="{StaticResource GlassStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Your library" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextLight}" />
                        <Label Text="Return to the channels and films you watched."
                               FontSize="12" TextColor="{StaticResource TextMuted}" />
                        <Button Text="Recently watched"
                                Style="{StaticResource GhostButton}"
                                Clicked="OnRecentlyWatchedClicked"
                                SemanticProperties.Description="Open recently watched channels and films" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource NightPanel}"
                        Stroke="{StaticResource GlassStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Find something" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextLight}" />
                        <Label Text="Search across channels, sport, news and films."
                               FontSize="12" TextColor="{StaticResource TextMuted}" />
                        <Button Text="Search MarkUpTV"
                                Style="{StaticResource GhostButton}"
                                Clicked="OnSearchClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource NightPanel}"
                        Stroke="{StaticResource GlassStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Join the conversation" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextLight}" />
                        <Label Text="Meet fellow viewers and share your thoughts."
                               FontSize="12" TextColor="{StaticResource TextMuted}" />
                        <Button Text="Community"
                                Style="{StaticResource GhostButton}"
                                Clicked="OnCommunityClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource NightPanel}"
                        Stroke="{StaticResource GlassStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Support the service" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextLight}" />
                        <Label Text="Help MarkUpTV continue improving."
                               FontSize="12" TextColor="{StaticResource TextMuted}" />
                        <Button Text="Support MarkUpTV"
                                Style="{StaticResource GhostButton}"
                                Clicked="OnSupportClicked" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>