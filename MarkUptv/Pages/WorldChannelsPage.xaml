<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarkUptv.ViewModels"
             xmlns:models="clr-namespace:MarkUptv.Models"
             x:Class="MarkUptv.Pages.WorldChannelsPage"
             x:DataType="vm:WorldChannelsViewModel"
             Title="World Channels"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource DeepVoid}">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0E1A" Offset="0" />
            <GradientStop Color="#101726" Offset="0.55" />
            <GradientStop Color="#0D1424" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,Auto,*" Padding="18" RowSpacing="12">

        <!-- ══════════ HEADER ══════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">

            <VerticalStackLayout Spacing="4" VerticalOptions="Center">

                <Label Text="World Channels"
                       FontSize="24"
                       FontAttributes="Bold"
                       CharacterSpacing="0.3"
                       TextColor="{StaticResource TextLight}" />

                <Label Text="Free, official sports broadcasters by country. Nothing paid, nothing pirated."
                       FontSize="12.5"
                       TextColor="{StaticResource TextMuted}" />

            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Playback self-test"
                    Command="{Binding SelfTestCommand}"
                    BackgroundColor="Transparent"
                    BorderColor="#E8B54A"
                    BorderWidth="1"
                    TextColor="#E8B54A"
                    FontSize="12.5"
                    HeightRequest="42"
                    VerticalOptions="Center" />

        </Grid>

        <!-- ══════════ SEARCH + SUMMARY ══════════ -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">

            <Border BackgroundColor="{StaticResource NightPanel}"
                    Stroke="{StaticResource GlassStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,0">

                <Entry Text="{Binding SearchText}"
                       Placeholder="Search country, channel, language or league"
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextLight}"
                       HeightRequest="46"
                       FontSize="13.5" />

            </Border>

            <Label Text="{Binding SummaryText}"
                   FontSize="12"
                   TextColor="{StaticResource TextMuted}" />

        </VerticalStackLayout>

        <!-- ══════════ CHANNEL LIST ══════════ -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Groups}"
                        IsGrouped="True"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>

                <!-- Two sources per row instead of one per screen; every
                     metadata line the row carried is still rendered. -->
                <GridItemsLayout Orientation="Vertical"
                                 Span="{OnIdiom Phone=1, Tablet=3, Desktop=4, TV=4}"
                                 HorizontalItemSpacing="10"
                                 VerticalItemSpacing="10" />

            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:WorldChannelGroup">

                    <VerticalStackLayout Spacing="2" Padding="2,14,2,8">

                        <Label Text="{Binding Country}"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#E8B54A" />

                        <Label Text="{Binding Summary}"
                               FontSize="11.5"
                               TextColor="{StaticResource TextMuted}" />

                    </VerticalStackLayout>

                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LiveSource">

                    <!-- Compact 2-up card: presenter, channel, origin, legality,
                         leagues and access all stay on the card. -->
                    <Border Margin="0,0,0,10"
                            Padding="11,10"
                            BackgroundColor="{StaticResource NightPanel}"
                            Stroke="{StaticResource GlassStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChannelTapped" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="3">

                            <Label Text="{Binding Label}"
                                   FontSize="13.5"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextLight}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />

                            <Label Text="{Binding Channel}"
                                   FontSize="11.5"
                                   TextColor="{StaticResource TextMuted}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />

                            <Label Text="{Binding OriginLine}"
                                   FontSize="10.5"
                                   TextColor="{StaticResource TextMuted}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />

                            <Label Text="{Binding Legality}"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   Opacity="0.85" />

                            <Label Text="{Binding League}"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />

                            <Border Padding="7,3"
                                    BackgroundColor="#1AE8B54A"
                                    Stroke="#44E8B54A"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    HorizontalOptions="Start">
                                <Label Text="{Binding AccessLine}"
                                       FontSize="9.5"
                                       FontAttributes="Bold"
                                       TextColor="#E8B54A" />
                            </Border>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>

