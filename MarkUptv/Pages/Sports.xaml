<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MarkUptv.Pages.Sports"
    xmlns:views="clr-namespace:MarkUptv.Views"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:MarkUptv.Models"
    xmlns:helpers="clr-namespace:MarkUptv.Helpers"
    xmlns:conv="clr-namespace:MarkUptv.Converters"
    xmlns:vm="clr-namespace:MarkUptv.ViewModels"
    x:DataType="vm:SportsViewModel"
    Title="Live Sports"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <helpers:InvertBoolConverter
            x:Key="InvertBoolConverter" />

        <!-- Player stage height. The stage only needs to be a tall surface
             while something is actually playing; when idle it shrinks to a
             compact standby tile so the channel list - the thing the user came
             for - sits above the fold instead of below a third of empty
             screen. -->

        <helpers:BoolToNumberConverter
            x:Key="PlayerStageHeight"
            TrueValue="232"
            FalseValue="150" />

        <helpers:StringNullOrEmptyConverter
            x:Key="StringNullOrEmptyConverter" />

        <conv:IsNotNullConverter
            x:Key="IsNotNullConverter" />

        <conv:ChannelSubtitleConverter
            x:Key="ChannelSubtitleConverter" />

        <Color x:Key="SportsGold">#E8B54A</Color>
        <Color x:Key="SportsOrange">#FF6A2B</Color>
        <Color x:Key="SportsRed">#E63946</Color>
        <Color x:Key="SportsMuted">#C4B5C2</Color>
        <Color x:Key="LiveRed">#E8254D</Color>

        <LinearGradientBrush
            x:Key="SportsPageBrush"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#0B0712"
                Offset="0" />

            <GradientStop
                Color="#250A1C"
                Offset="0.5" />

            <GradientStop
                Color="#3A0B12"
                Offset="1" />

        </LinearGradientBrush>

        <LinearGradientBrush
            x:Key="SportsHeroBrush"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#FF9A3D"
                Offset="0" />

            <GradientStop
                Color="#FF4B2E"
                Offset="0.55" />

            <GradientStop
                Color="#C2185B"
                Offset="1" />

        </LinearGradientBrush>

        <Style
            x:Key="SportsCardStyle"
            TargetType="Border">

            <Setter
                Property="BackgroundColor"
                Value="#E0150F23" />

            <Setter
                Property="Stroke"
                Value="#30FFFFFF" />

            <Setter
                Property="StrokeThickness"
                Value="1" />

            <Setter
                Property="StrokeShape"
                Value="RoundRectangle 22" />

        </Style>

    </ContentPage.Resources>

    <ContentPage.Background>
        <StaticResource Key="SportsPageBrush" />
    </ContentPage.Background>

    <Grid
        RowDefinitions="Auto,*"
        Padding="{OnIdiom Phone='13,19,13,13',
                          Tablet='20,23,20,18',
                          Desktop='26,25,26,22',
                          TV='42,37,42,32'}"
        RowSpacing="18">

        <Label
            Grid.RowSpan="2"
            Text="🏆"
            FontSize="120"
            TextColor="#10FFFFFF"
            Margin="-30,140,0,0"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            InputTransparent="True" />

        <Label
            Grid.RowSpan="2"
            Text="⚽"
            FontSize="120"
            TextColor="#10FF4D8D"
            Margin="0,0,-30,90"
            HorizontalOptions="End"
            VerticalOptions="End"
            InputTransparent="True" />

        <!-- =========================================================
             HEADER
             ========================================================= -->

        <Grid
            x:Name="HeaderPanel"
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="14"
            MaximumWidthRequest="1600"
            HorizontalOptions="Center">

            <Button
                Text="☰"
                Command="{Binding OpenFlyoutCommand}"
                Clicked="OnAnimatedButtonClicked"
                WidthRequest="48"
                HeightRequest="48"
                Padding="0"
                CornerRadius="16"
                FontSize="22"
                BackgroundColor="#16FFFFFF"
                BorderColor="#35FFFFFF"
                BorderWidth="1"
                TextColor="White"
                SemanticProperties.Description="Open navigation" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                VerticalOptions="Center">

                <HorizontalStackLayout
                    Spacing="10"
                    VerticalOptions="Center">

                    <Label
                        Text="SPORTS"
                        FontSize="{OnIdiom Phone=22,
                                           Tablet=26,
                                           Desktop=28,
                                           TV=36}"
                        FontAttributes="Bold"
                        CharacterSpacing="1.2"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Border
                        Padding="9,3"
                        BackgroundColor="#22FF4D8D"
                        Stroke="#55FF4D8D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 9"
                        VerticalOptions="Center">

                        <HorizontalStackLayout
                            Spacing="5"
                            VerticalOptions="Center">

                            <Border
                                WidthRequest="7"
                                HeightRequest="7"
                                BackgroundColor="{StaticResource SportsGold}"
                                StrokeShape="RoundRectangle 4"
                                VerticalOptions="Center" />

                            <Label
                                Text="LIVE TV"
                                FontSize="8"
                                FontAttributes="Bold"
                                CharacterSpacing="1"
                                TextColor="{StaticResource SportsGold}"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                    </Border>

                </HorizontalStackLayout>

                <Label
                    Text="Live action from every sport — 24/7"
                    FontSize="11.5"
                    TextColor="{StaticResource SportsMuted}" />

            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Text="⟳"
                Command="{Binding RefreshCommand}"
                Clicked="OnAnimatedButtonClicked"
                WidthRequest="48"
                HeightRequest="48"
                Padding="0"
                CornerRadius="16"
                FontSize="19"
                BackgroundColor="{StaticResource SportsOrange}"
                BorderColor="#70FFFFFF"
                BorderWidth="1"
                TextColor="White"
                SemanticProperties.Description="Refresh sports channels" />

        </Grid>

        <!-- =========================================================
             WORKSPACE
             ========================================================= -->

        <Grid
            x:Name="WorkspaceGrid"
            Grid.Row="1"
            RowDefinitions="Auto,*"
            ColumnDefinitions="*"
            RowSpacing="16"
            MaximumWidthRequest="1600"
            HorizontalOptions="Center">

            <VisualStateManager.VisualStateGroups>

                <VisualStateGroup x:Name="LayoutStates">

                    <VisualState x:Name="Narrow">

                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>

                        <VisualState.Setters>

                            <Setter
                                Property="RowDefinitions"
                                Value="Auto,*" />

                            <Setter
                                Property="ColumnDefinitions"
                                Value="*" />

                            <Setter
                                TargetName="PlayerPanel"
                                Property="Grid.Row"
                                Value="0" />

                            <Setter
                                TargetName="PlayerPanel"
                                Property="Grid.Column"
                                Value="0" />

                            <!-- The player panel hugs its own content: the stage
                                 binding already reserves a compact standby tile
                                 and a 16:9 tile while playing, so a fixed 310dp
                                 panel would only add dead space above the
                                 channel list. -->

                            <Setter
                                TargetName="ChannelPanel"
                                Property="Grid.Row"
                                Value="1" />

                            <Setter
                                TargetName="ChannelPanel"
                                Property="Grid.Column"
                                Value="0" />

                            <Setter
                                TargetName="ChannelPanel"
                                Property="Margin"
                                Value="0" />

                        </VisualState.Setters>

                    </VisualState>

                    <VisualState x:Name="Wide">

                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>

                        <VisualState.Setters>

                            <Setter
                                Property="RowDefinitions"
                                Value="*" />

                            <Setter
                                Property="ColumnDefinitions"
                                Value="7*,5*" />

                            <Setter
                                TargetName="PlayerPanel"
                                Property="Grid.Row"
                                Value="0" />

                            <Setter
                                TargetName="PlayerPanel"
                                Property="Grid.Column"
                                Value="0" />

                            <Setter
                                TargetName="PlayerPanel"
                                Property="HeightRequest"
                                Value="-1" />

                            <Setter
                                TargetName="PlayerPanel"
                                Property="Margin"
                                Value="0,0,18,0" />

                            <Setter
                                TargetName="ChannelPanel"
                                Property="Grid.Row"
                                Value="0" />

                            <Setter
                                TargetName="ChannelPanel"
                                Property="Grid.Column"
                                Value="1" />

                            <Setter
                                TargetName="ChannelPanel"
                                Property="Margin"
                                Value="0" />

                        </VisualState.Setters>

                    </VisualState>

                </VisualStateGroup>

            </VisualStateManager.VisualStateGroups>

            <!-- ============================
                 PLAYER PANEL
                 ============================ -->

            <Border
                x:Name="PlayerPanel"
                Style="{StaticResource SportsCardStyle}"
                Padding="9">

                <Grid
                    RowDefinitions="Auto,Auto"
                    RowSpacing="9">

                    <!-- Now streaming hero strip -->

                    <Border
                        Padding="15,12"
                        Background="{StaticResource SportsHeroBrush}"
                        Stroke="#45FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 17">

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="13">

                            <Border
                                WidthRequest="46"
                                HeightRequest="46"
                                BackgroundColor="#25FFFFFF"
                                Stroke="#70FFFFFF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 15">

                                <Label
                                    Text="🏆"
                                    FontSize="21"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">

                                <Label
                                    Text="NOW STREAMING"
                                    IsVisible="{Binding IsPlayerVisible}"
                                    FontSize="8"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1.7"
                                    TextColor="{StaticResource SportsGold}" />

                                <Label
                                    Text="STANDBY"
                                    IsVisible="{Binding IsPlayerVisible,
                                                        Converter={StaticResource InvertBoolConverter}}"
                                    FontSize="8"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1.7"
                                    TextColor="#E0FFFFFF" />

                                <Label
                                    Text="{Binding NowPlayingText}"
                                    FontSize="15.5"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    MaxLines="1"
                                    LineBreakMode="TailTruncation" />

                            </VerticalStackLayout>

                            <HorizontalStackLayout
                                Grid.Column="2"
                                Spacing="8"
                                VerticalOptions="Center">

                                <Border
                                    Padding="10,5"
                                    BackgroundColor="#E8FF4D8D"
                                    Stroke="#FFFFD9E0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    IsVisible="{Binding IsStreaming}">

                                    <HorizontalStackLayout
                                        Spacing="6"
                                        VerticalOptions="Center">

                                        <Border
                                            WidthRequest="7"
                                            HeightRequest="7"
                                            BackgroundColor="#FF6B81"
                                            Stroke="White"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 4"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="LIVE"
                                            FontSize="8.5"
                                            FontAttributes="Bold"
                                            CharacterSpacing="1"
                                            TextColor="White"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                                <ActivityIndicator
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    IsRunning="{Binding IsPlayerLoading}"
                                    IsVisible="{Binding IsPlayerLoading}"
                                    Color="{StaticResource SportsGold}"
                                    VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </Grid>

                    </Border>

                    <!-- Video / idle art stage -->

                    <Border
                        Grid.Row="1"
                        HeightRequest="{Binding IsPlayerVisible,
                                              Converter={StaticResource PlayerStageHeight}}"
                        BackgroundColor="#020207"
                        Stroke="#55FF4D8D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 19">

                        <Grid IsClippedToBounds="True">

                            <toolkit:MediaElement x:Name="ChannelPlayer"
                                Source="{Binding SelectedChannel.StreamUrl,
                                                 TargetNullValue=''}"
                                ShouldAutoPlay="True"
                                ShouldShowPlaybackControls="True"
                                ShouldKeepScreenOn="True"
                                Volume="1"
                                IsVisible="{Binding IsPlayerVisible}"
                                MediaOpened="OnMediaOpened"
                                MediaFailed="OnMediaFailed" />

                            <!-- On-air chip over the picture -->

                            <Border
                                Padding="10,5"
                                Margin="12"
                                BackgroundColor="#E8FF4D8D"
                                Stroke="#FFFFD9E0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 11"
                                IsVisible="{Binding IsStreaming}"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                InputTransparent="True">

                                <HorizontalStackLayout
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Border
                                        WidthRequest="8"
                                        HeightRequest="8"
                                        BackgroundColor="#FF6B81"
                                        Stroke="White"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />

                                    <Label
                                        Text="ON AIR"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1.1"
                                        TextColor="White"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>

                            </Border>

                            <!-- Idle artwork -->

                            <VerticalStackLayout
                                IsVisible="{Binding IsPlayerVisible,
                                                    Converter={StaticResource InvertBoolConverter}}"
                                Spacing="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                                <Grid
                                    WidthRequest="120"
                                    HeightRequest="120">

                                    <Border
                                        WidthRequest="120"
                                        HeightRequest="120"
                                        BackgroundColor="#14FF4D8D"
                                        Stroke="#25FFFFFF"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 95"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />

                                    <Border
                                        WidthRequest="76"
                                        HeightRequest="76"
                                        Background="{StaticResource SportsHeroBrush}"
                                        Stroke="#90FFFFFF"
                                        StrokeThickness="2"
                                        StrokeShape="RoundRectangle 59"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">

                                        <Border.Shadow>

                                            <Shadow
                                                Brush="#B0FF4D8D"
                                                Offset="0,8"
                                                Radius="22"
                                                Opacity="0.65" />

                                        </Border.Shadow>

                                        <Label
                                            Text="🏆"
                                            FontSize="40"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />

                                    </Border>

                                    <Border
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        Margin="-18,0,0,0"
                                        BackgroundColor="{StaticResource SportsGold}"
                                        Stroke="White"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 19"
                                        HorizontalOptions="End"
                                        VerticalOptions="End"
                                        InputTransparent="True">

                                        <Label
                                            Text="⚽"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />

                                    </Border>

                                </Grid>

                                <Label
                                    Text="GAME ON"
                                    Margin="0,17,0,0"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1.4"
                                    TextColor="White"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="Pick a channel and dive into the action."
                                    Margin="0,5,0,0"
                                    FontSize="12"
                                    TextColor="{StaticResource SportsMuted}"
                                    HorizontalOptions="Center" />

                                <Border
                                    Margin="0,16,0,0"
                                    Padding="14,6"
                                    BackgroundColor="#1AFF4D8D"
                                    Stroke="#40FF4D8D"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="LIVE SPORTS  •  WORLDWIDE  •  24/7"
                                        FontSize="8.5"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1.3"
                                        TextColor="{StaticResource SportsGold}" />

                                </Border>

                            </VerticalStackLayout>

                            <ActivityIndicator
                                WidthRequest="56"
                                HeightRequest="56"
                                IsRunning="{Binding IsPlayerLoading}"
                                IsVisible="{Binding IsPlayerLoading}"
                                Color="{StaticResource SportsGold}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                ZIndex="20" />

                        </Grid>

                    </Border>

                </Grid>

            </Border>

            <!-- ============================
                 CHANNEL PANEL
                 ============================ -->

            <Border
                x:Name="ChannelPanel"
                Style="{StaticResource SportsCardStyle}"
                Padding="15">

                <Grid
                    RowDefinitions="Auto,Auto,*"
                    RowSpacing="12">

                    <!-- Search -->

                    <Border
                        x:Name="SearchBorder"
                        Grid.Row="0"
                        HeightRequest="47"
                        Padding="8,0"
                        BackgroundColor="#D00A0E22"
                        Stroke="#35FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">

                        <Grid ColumnDefinitions="Auto,*">

                            <Label
                                Text="⌕"
                                WidthRequest="38"
                                FontSize="26"
                                TextColor="{StaticResource SportsOrange}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                            <Entry
                                Grid.Column="1"
                                Text="{Binding SearchText}"
                                Placeholder="Search sports channels..."
                                PlaceholderColor="#8A7A8A"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                FontSize="13"
                                ClearButtonVisibility="WhileEditing"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                    <!-- Sport chips -->

                    <CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding Groups}"
                        SelectedItem="{Binding SelectedGroup,
                                               Mode=TwoWay}"
                        SelectionMode="Single"
                        HeightRequest="44"
                        HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemsLayout>

                            <LinearItemsLayout
                                Orientation="Horizontal"
                                ItemSpacing="8" />

                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>

                            <DataTemplate x:DataType="x:String">

                                <Border
                                    Padding="17,0"
                                    BackgroundColor="#14FFFFFF"
                                    Stroke="#28FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22">

                                    <VisualStateManager.VisualStateGroups>

                                        <VisualStateGroupList>

                                            <VisualStateGroup x:Name="CommonStates">

                                                <VisualState x:Name="Normal" />

                                                <VisualState x:Name="Selected">

                                                    <VisualState.Setters>

                                                        <Setter
                                                            Property="BackgroundColor"
                                                            Value="{StaticResource SportsOrange}" />

                                                        <Setter
                                                            Property="Stroke"
                                                            Value="{StaticResource SportsGold}" />

                                                        <Setter
                                                            Property="StrokeThickness"
                                                            Value="1.5" />

                                                    </VisualState.Setters>

                                                </VisualState>

                                            </VisualStateGroup>

                                        </VisualStateGroupList>

                                    </VisualStateManager.VisualStateGroups>

                                    <Label
                                        Text="{Binding .}"
                                        FontSize="11.5"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        TextTransform="Uppercase"
                                        LineBreakMode="NoWrap"
                                        MaxLines="1"
                                        VerticalOptions="Center" />

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <!-- Channel list -->

                    <RefreshView
                        Grid.Row="2"
                        Command="{Binding RefreshCommand}"
                        IsRefreshing="{Binding IsLoading}"
                        RefreshColor="{StaticResource SportsOrange}">

                        <CollectionView
                            ItemsSource="{Binding Channels}"
                            SelectionMode="None">

                            <CollectionView.ItemsLayout>

                                <GridItemsLayout
                                    Orientation="Vertical"
                                    Span="{OnIdiom Phone=2, Tablet=4, Desktop=6, TV=6}"
                                    HorizontalItemSpacing="10"
                                    VerticalItemSpacing="10" />

                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>

                                <DataTemplate x:DataType="models:TvChannel">

                                    <!-- Dense 2-up tile: 6-8 channels per screen instead of
                                         3-5. The tile itself models this page's
                                         now-playing state (gold frame + LIVE pill),
                                         and CardTapped keeps whole-row tune-in. -->
                                    <views:ChannelTileCard
                                        CardTapped="OnChannelCardTapped"
                                        WatchClicked="OnWatchClicked" />

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>

                                <VerticalStackLayout
                                    Spacing="9"
                                    Margin="0,50"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="🏆"
                                        FontSize="64"
                                        Opacity="0.7"
                                        HorizontalOptions="Center" />

                                    <Label
                                        Text="No sports channels found"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        HorizontalOptions="Center" />

                                    <Label
                                        Text="Try another search or genre, or refresh the list."
                                        FontSize="11.5"
                                        TextColor="{StaticResource SportsMuted}"
                                        HorizontalOptions="Center" />

                                </VerticalStackLayout>

                            </CollectionView.EmptyView>

                        </CollectionView>

                    </RefreshView>

                    <!-- Error toast -->

                    <Border
                        Grid.Row="2"
                        Padding="13,9"
                        Margin="8"
                        BackgroundColor="#D0B3123F"
                        Stroke="#FFFFAEC2"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        IsVisible="{Binding HasError}"
                        ZIndex="25">

                        <Label
                            Text="{Binding ErrorMessage}"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>


