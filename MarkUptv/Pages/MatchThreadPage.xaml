<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarkUptv.ViewModels"
             xmlns:models="clr-namespace:MarkUptv.Models"
             x:Class="MarkUptv.Pages.MatchThreadPage"
             x:DataType="vm:MatchThreadViewModel"
             Title="Match thread"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource DeepVoid}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="18" RowSpacing="12">

        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">

            <VerticalStackLayout Spacing="4" VerticalOptions="Center">

                <Label Text="{Binding ThreadTitle}"
                       FontSize="21"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextLight}"
                       LineBreakMode="TailTruncation" />

                <Label Text="{Binding LeagueText}"
                       FontSize="12"
                       TextColor="{StaticResource Primary}" />

                <Label Text="{Binding SummaryText}"
                       FontSize="11.5"
                       TextColor="{StaticResource TextMuted}" />

            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="{Binding FollowLabel}"
                    Command="{Binding FollowTeamCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource PrimaryDarkText}"
                    FontSize="12.5"
                    HeightRequest="42"
                    VerticalOptions="Center" />

        </Grid>

        <!-- REPLY TARGET -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasReplyTarget}"
                BackgroundColor="#1AE8B54A"
                Stroke="#44E8B54A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="12,8">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                <Label Text="{Binding ReplyTargetLabel}"
                       FontSize="12"
                       TextColor="{StaticResource Primary}"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="Cancel"
                        Command="{Binding CancelReplyCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextMuted}"
                        FontSize="11.5"
                        HeightRequest="34" />

            </Grid>

        </Border>

        <!-- POSTS -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Posts}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" Spacing="8">
                    <Label Text="No posts yet"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextLight}"
                           HorizontalOptions="Center" />
                    <Label Text="Share your take on the match. Posts are stored on this device immediately."
                           FontSize="12.5"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ThreadPost">

                    <Border Margin="0,0,0,10"
                            Padding="14,12"
                            BackgroundColor="{StaticResource NightPanel}"
                            Stroke="{StaticResource GlassStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="8">

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Author}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextLight}" />
                                <Label Text="{Binding TimeAgo}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding Text}"
                                   FontSize="13.5"
                                   TextColor="{StaticResource TextLight}" />

                            <HorizontalStackLayout Spacing="10">

                                <Button Text="{Binding ReactionLabel, StringFormat='♥ {0}'}"
                                        Clicked="OnReactClicked"
                                        BackgroundColor="Transparent"
                                        BorderColor="{StaticResource Primary}"
                                        BorderWidth="1"
                                        TextColor="{StaticResource Primary}"
                                        FontSize="12"
                                        HeightRequest="36" />

                                <Button Text="{Binding CommentLabel}"
                                        Clicked="OnReplyClicked"
                                        BackgroundColor="Transparent"
                                        BorderColor="{StaticResource GlassStroke}"
                                        BorderWidth="1"
                                        TextColor="{StaticResource TextMuted}"
                                        FontSize="12"
                                        HeightRequest="36" />

                                <Button Text="Report"
                                        Clicked="OnReportClicked"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMuted}"
                                        FontSize="12"
                                        HeightRequest="36" />

                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="4"
                                                 BindableLayout.ItemsSource="{Binding Comments}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ThreadComment">
                                        <Label Text="{Binding Line}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextMuted}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- COMPOSER -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">

            <Border BackgroundColor="{StaticResource NightPanel}"
                    Stroke="{StaticResource GlassStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,0">

                <Entry Text="{Binding ComposerText}"
                       Placeholder="Say something about the match"
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextLight}"
                       HeightRequest="46"
                       FontSize="13.5"
                       ReturnCommand="{Binding PostCommand}" />

            </Border>

            <Button Grid.Column="1"
                    Text="Post"
                    Command="{Binding PostCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource PrimaryDarkText}"
                    HeightRequest="46"
                    WidthRequest="88"
                    FontSize="13.5" />

        </Grid>

    </Grid>

</ContentPage>
