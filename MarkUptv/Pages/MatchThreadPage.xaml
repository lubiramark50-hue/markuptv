<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarkUptv.ViewModels"
             xmlns:models="clr-namespace:MarkUptv.Models"
             x:Class="MarkUptv.Pages.MatchThreadPage"
             x:DataType="vm:MatchThreadViewModel"
             Title="Match thread"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource DeepVoid}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,12,16,12" RowSpacing="12">

        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Button Text="&#8249;"
                    Clicked="OnBackClicked"
                    FontSize="26"
                    Padding="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BackgroundColor="{StaticResource NightPanel}"
                    BorderColor="{StaticResource GlassStroke}"
                    BorderWidth="1"
                    TextColor="{StaticResource TextLight}"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Back" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding ThreadTitle}"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextLight}"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding LeagueText}"
                       FontSize="12"
                       TextColor="{StaticResource Primary}"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding SummaryText}"
                       FontSize="11.5"
                       TextColor="{StaticResource TextMuted}"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Text="{Binding FollowLabel}"
                    Command="{Binding FollowTeamCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource PrimaryDarkText}"
                    FontSize="12.5"
                    FontAttributes="Bold"
                    CornerRadius="21"
                    Padding="16,0"
                    HeightRequest="42"
                    VerticalOptions="Center" />
        </Grid>

        <!-- REPLY TARGET -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasReplyTarget}"
                BackgroundColor="#1AE8B54A"
                Stroke="#44E8B54A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="14,6,6,6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Text="{Binding ReplyTargetLabel}"
                       FontSize="12"
                       TextColor="{StaticResource Primary}"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Cancel"
                        Command="{Binding CancelReplyCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextMuted}"
                        FontSize="11.5"
                        HeightRequest="36" />
            </Grid>
        </Border>

        <!-- POSTS -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Posts}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,48" Spacing="8">
                    <Label Text="No posts yet"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextLight}"
                           HorizontalOptions="Center" />
                    <Label Text="Be the first to share your take on the match. Posts are saved on this device."
                           FontSize="12.5"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ThreadPost">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,12">
                        <Border WidthRequest="38"
                                HeightRequest="38"
                                StrokeShape="RoundRectangle 19"
                                BackgroundColor="#26E8B54A"
                                Stroke="#55E8B54A"
                                StrokeThickness="1"
                                VerticalOptions="Start">
                            <Label Text="{Binding Initial}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1"
                                Padding="14,10,14,8"
                                BackgroundColor="{StaticResource NightPanel}"
                                Stroke="{StaticResource GlassStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 4,18,18,18">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsOwn}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="#1AE8B54A" />
                                    <Setter Property="Stroke" Value="#66E8B54A" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Author}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextLight}" />
                                    <Label Text="{Binding TimeAgo}"
                                           FontSize="11"
                                           TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Text}"
                                       FontSize="14"
                                       LineHeight="1.25"
                                       TextColor="{StaticResource TextLight}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="{Binding ReactionLabel, StringFormat='&#9829; {0}'}"
                                            Clicked="OnReactClicked"
                                            BackgroundColor="Transparent"
                                            BorderColor="{StaticResource Primary}"
                                            BorderWidth="1"
                                            CornerRadius="17"
                                            Padding="14,0"
                                            TextColor="{StaticResource Primary}"
                                            FontSize="12"
                                            HeightRequest="34" />
                                    <Button Text="{Binding CommentLabel}"
                                            Clicked="OnReplyClicked"
                                            BackgroundColor="Transparent"
                                            BorderColor="{StaticResource GlassStroke}"
                                            BorderWidth="1"
                                            CornerRadius="17"
                                            Padding="14,0"
                                            TextColor="{StaticResource TextMuted}"
                                            FontSize="12"
                                            HeightRequest="34" />
                                    <Button Text="Report"
                                            Clicked="OnReportClicked"
                                            BackgroundColor="Transparent"
                                            Padding="10,0"
                                            TextColor="{StaticResource TextMuted}"
                                            FontSize="11.5"
                                            HeightRequest="34" />
                                </HorizontalStackLayout>
                                <VerticalStackLayout Spacing="4"
                                                     Margin="8,2,0,0"
                                                     BindableLayout.ItemsSource="{Binding Comments}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ThreadComment">
                                            <Label Text="{Binding Line}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextMuted}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- COMPOSER -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,0,0,4">
            <Border BackgroundColor="{StaticResource NightPanel}"
                    Stroke="{StaticResource GlassStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="16,0">
                <Entry Text="{Binding ComposerText}"
                       Placeholder="Say something about the match"
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextLight}"
                       BackgroundColor="Transparent"
                       HeightRequest="48"
                       FontSize="14"
                       MaxLength="500"
                       ReturnType="Send"
                       ReturnCommand="{Binding PostCommand}" />
            </Border>
            <Button Grid.Column="1"
                    Text="&#8593;"
                    Command="{Binding PostCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource PrimaryDarkText}"
                    FontSize="22"
                    FontAttributes="Bold"
                    Padding="0"
                    CornerRadius="24"
                    HeightRequest="48"
                    WidthRequest="48"
                    SemanticProperties.Description="Post" />
        </Grid>
    </Grid>
</ContentPage>
