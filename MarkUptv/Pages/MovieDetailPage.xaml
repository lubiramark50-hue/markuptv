<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MarkUptv.Pages.MovieDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MarkUptv.Controls"
    xmlns:helpers="clr-namespace:MarkUptv.Helpers"
    xmlns:models="clr-namespace:MarkUptv.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MarkUptv.ViewModels"
    x:DataType="vm:MovieDetailViewModel"
    Title="Film"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#070712">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <helpers:InvertBoolConverter x:Key="InvertBool" />
        <helpers:StringNullOrEmptyConverter x:Key="NotEmpty" />

        <Style x:Key="ActionButton" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Padding="16,52,16,8"
              ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

            <Border Grid.Column="0"
                    WidthRequest="42" HeightRequest="42"
                    StrokeShape="RoundRectangle 21"
                    Stroke="#1E1E38" BackgroundColor="{StaticResource DeepVoid}">
                <Label Text="←" FontSize="20" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   MaxLines="2"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center" />

            <Border Grid.Column="2"
                    WidthRequest="42" HeightRequest="42"
                    StrokeShape="RoundRectangle 21"
                    Stroke="{StaticResource AccentPink}" BackgroundColor="#1AFF4D8D">
                <Label Text="⤓" FontSize="18" TextColor="{StaticResource AccentPink}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenDownloadsCommand}" />
                </Border.GestureRecognizers>
            </Border>

        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="0,0,0,40">

                <!-- ═══ PLAYER STAGE ═══ -->
                <Grid HeightRequest="230" Margin="16,0" BackgroundColor="#000000">
                    <toolkit:MediaElement x:Name="FilmPlayer"
                                          Source="{Binding PlayerSource}"
                                          ShouldAutoPlay="True"
                                          ShouldShowPlaybackControls="True"
                                          ShouldKeepScreenOn="True"
                                          Aspect="AspectFit"
                                          IsVisible="{Binding IsPlayerVisible}" />

                    <VerticalStackLayout IsVisible="{Binding IsPlayerVisible, Converter={StaticResource InvertBool}}"
                                         HorizontalOptions="Fill" VerticalOptions="Fill"
                                         Spacing="10">
                        <Image Source="{Binding PosterUrl}"
                               Aspect="AspectFill"
                               IsVisible="{Binding HasPoster}"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="{StaticResource AccentPink}"
                                           HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- ═══ DAY PASS ═══
                     Locked: the offer, priced by the server. Active: a quiet
                     strip with the countdown, so a paying viewer can see the
                     value ticking instead of guessing. -->
                <controls:DayPassCard
                    Margin="16,0"
                    IsVisible="{Binding PassActive}"
                    IsActive="True"
                    PriceText="{Binding PassPriceText}"
                    DurationText="{Binding PassDurationText}"
                    ExpiryText="{Binding PassExpiryText}" />

                <controls:DayPassCard
                    Margin="16,0"
                    IsVisible="{Binding PassLocked}"
                    IsActive="False"
                    PriceText="{Binding PassPriceText}"
                    DurationText="{Binding PassDurationText}"
                    Email="{Binding PassEmail, Mode=TwoWay}"
                    Message="{Binding PassMessage}"
                    IsBusy="{Binding IsBuyingPass}"
                    PayCommand="{Binding BuyPassCommand}" />

                <!-- ═══ ACTIONS ═══ -->
                <Grid Margin="16,0" ColumnDefinitions="*,*" ColumnSpacing="12"
                      IsVisible="{Binding ActionsVisible}">

                    <Border Grid.Column="0" Style="{StaticResource ActionButton}"
                            BackgroundColor="{StaticResource AccentPink}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PlayCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding PlayLabel}" FontSize="14"
                               FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" />
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ActionButton}"
                            BackgroundColor="#1A1A38">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleDownloadCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding DownloadLabel}" FontSize="14"
                               FontAttributes="Bold" TextColor="#C8D0E0"
                               HorizontalOptions="Center" />
                    </Border>

                </Grid>

                <Border IsVisible="{Binding IsPlayerVisible}"
                        Margin="16,0"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#1E1E38" BackgroundColor="{StaticResource DeepVoid}"
                        Padding="14,10">
                    <Label Text="Stop playback" FontSize="13" TextColor="{StaticResource AccentPink}"
                           HorizontalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StopPlaybackCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- ═══ DOWNLOAD PROGRESS ═══ -->
                <VerticalStackLayout Spacing="6" Margin="16,0">
                    <ProgressBar Progress="{Binding DownloadProgress}"
                                 ProgressColor="#00D4FF"
                                 IsVisible="{Binding IsDownloadBusy}" />
                    <Label Text="{Binding DownloadStatus}"
                           FontSize="12" TextColor="#00D4FF" />
                </VerticalStackLayout>

                <!-- ═══ META ═══ -->
                <VerticalStackLayout Spacing="6" Margin="16,0">
                    <Label Text="{Binding MetaLine}" FontSize="12" TextColor="#8A8A9E" />
                    <Label Text="{Binding Description}"
                           FontSize="13" TextColor="#C8D0E0"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- ═══ BADGES ═══ -->
                <HorizontalStackLayout Spacing="8" Margin="16,0">
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0"
                            BackgroundColor="#1A1A38" Padding="10,6"
                            IsVisible="{Binding IsSavedOffline}">
                        <Label Text="Saved offline" FontSize="11" TextColor="#00D4FF"
                               FontAttributes="Bold" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0"
                            BackgroundColor="#1A1A38" Padding="10,6"
                            IsVisible="{Binding HasRuntimeText}">
                        <Label Text="{Binding RuntimeText}" FontSize="11" TextColor="#C8D0E0" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0"
                            BackgroundColor="#1A1A38" Padding="10,6"
                            IsVisible="{Binding HasSizeText}">
                        <Label Text="{Binding SizeText}" FontSize="11" TextColor="#C8D0E0" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0"
                            BackgroundColor="#1A1A38" Padding="10,6">
                        <Label Text="{Binding LanguageText}" FontSize="11" TextColor="#C8D0E0" />
                    </Border>
                </HorizontalStackLayout>

                <!-- ═══ SUBTITLES ═══ -->
                <VerticalStackLayout Spacing="6" Margin="16,0">
                    <Label Text="Subtitles &amp; languages" FontSize="13"
                           FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding SubtitleSummary}" FontSize="12" TextColor="#8A8A9E" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Movie.Subtitles}"
                                         Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MovieSubtitle">
                                <Border StrokeShape="RoundRectangle 10"
                                        Stroke="#1E1E38" BackgroundColor="{StaticResource DeepVoid}"
                                        Padding="12,8">
                                    <Label Text="{Binding Label}" FontSize="12"
                                           TextColor="#C8D0E0" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ═══ SOURCE / ATTRIBUTION ═══ -->
                <Border Margin="16,0"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#1E1E38" BackgroundColor="{StaticResource DeepVoid}"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Source" FontSize="11" TextColor="#6E7A9A" />
                        <Label Text="{Binding SourceText}" FontSize="12" TextColor="#C8D0E0" />
                        <Label Text="Open source page" FontSize="12"
                               TextColor="{StaticResource AccentPink}" FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSourcePageCommand}"
                                                      CommandParameter="{Binding Movie.SourcePageUrl}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding ErrorText}"
                       IsVisible="{Binding HasErrorText}"
                       Margin="16,0"
                       FontSize="12" TextColor="{StaticResource AccentPink}" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
