<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MarkUptv.Pages.MovieCatalogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MarkUptv.Controls"
    xmlns:helpers="clr-namespace:MarkUptv.Helpers"
    xmlns:models="clr-namespace:MarkUptv.Models"
    xmlns:vm="clr-namespace:MarkUptv.ViewModels"
    x:DataType="vm:MovieCatalogViewModel"
    Title="Movies"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#070712">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            EventName="Appearing"
            Command="{Binding InitializeCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>

        <helpers:InvertBoolConverter x:Key="InvertBool" />

        <Style x:Key="ShelfChip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="#1E1E38" />
            <Setter Property="BackgroundColor" Value="{StaticResource DeepVoid}" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <Style x:Key="LanguageChip" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="#221E1E38" />
            <Setter Property="BackgroundColor" Value="#120D0D22" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0"
              Padding="20,52,20,10"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="10">

            <Border Grid.Column="0"
                    WidthRequest="42" HeightRequest="42"
                    StrokeShape="RoundRectangle 21"
                    Stroke="#1E1E38"
                    BackgroundColor="{StaticResource DeepVoid}">
                <Border.Behaviors>
                    <helpers:TapScaleBehavior />
                </Border.Behaviors>
                <Path Style="{StaticResource IconPath}"
                      Data="{StaticResource IconMenu}"
                      Stroke="White" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenFlyoutCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding HeaderTitle}" FontSize="23"
                       FontAttributes="Bold" TextColor="White" />
                <Label Text="{Binding HeaderSubtitle}" FontSize="11"
                       TextColor="#6E7A9A" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    WidthRequest="42" HeightRequest="42"
                    StrokeShape="RoundRectangle 21"
                    Stroke="{StaticResource AccentPink}"
                    BackgroundColor="#1AFF4D8D">
                <Border.Behaviors>
                    <helpers:TapScaleBehavior />
                </Border.Behaviors>
                <Path Style="{StaticResource IconPath}"
                      Data="{StaticResource IconDownload}"
                      Stroke="{StaticResource AccentPink}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenDownloadsCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <Border Grid.Column="3"
                    WidthRequest="42" HeightRequest="42"
                    StrokeShape="RoundRectangle 21"
                    Stroke="#1E1E38"
                    BackgroundColor="{StaticResource DeepVoid}">
                <Border.Behaviors>
                    <helpers:TapScaleBehavior />
                </Border.Behaviors>
                <Path Style="{StaticResource IconPath}"
                      Data="{StaticResource IconRefresh}"
                      Stroke="#8A8A9E" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                </Border.GestureRecognizers>
            </Border>

        </Grid>

        <!-- ═══ SEARCH ═══ -->
        <Border Grid.Row="1"
                Margin="20,4,20,8"
                StrokeShape="RoundRectangle 16"
                Stroke="#1E1E38"
                StrokeThickness="1"
                BackgroundColor="{StaticResource DeepVoid}">

            <Grid ColumnDefinitions="Auto,*">
                <Path Style="{StaticResource IconPath}"
                      Data="{StaticResource IconSearch}"
                      Stroke="{StaticResource AccentPink}"
                      WidthRequest="20" HeightRequest="20"
                      Margin="0,0,4,0" />
                <Entry Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="Search films — title, cast, year…"
                       PlaceholderColor="#817995"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       FontSize="14"
                       ReturnType="Search"
                       ClearButtonVisibility="WhileEditing"
                       VerticalOptions="Center" />
            </Grid>

        </Border>

        <!-- ═══ DAY PASS ═══
             The films are the paid product, so the offer sits on the shelf
             itself: price and length come straight from the server, and once
             the pass is running the same card becomes a countdown. -->
        <controls:DayPassCard
            Grid.Row="2"
            Margin="20,2,20,10"
            IsVisible="{Binding PassActive}"
            IsActive="True"
            PriceText="{Binding PassPriceText}"
            DurationText="{Binding PassDurationText}"
            ExpiryText="{Binding PassExpiryText}" />

        <controls:DayPassCard
            Grid.Row="2"
            Margin="20,2,20,10"
            IsVisible="{Binding PassActive, Converter={StaticResource InvertBool}}"
            IsActive="False"
            PriceText="{Binding PassPriceText}"
            DurationText="{Binding PassDurationText}"
            Email="{Binding PassEmail, Mode=TwoWay}"
            Message="{Binding PassMessage}"
            IsBusy="{Binding IsBuyingPass}"
            PayCommand="{Binding BuyPassCommand}" />

        <!-- ═══ SHELVES + LANGUAGES ═══ -->
        <VerticalStackLayout Grid.Row="3" Spacing="6">

            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="20,0">
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Shelves}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ShelfOption">
                            <Border Style="{StaticResource ShelfChip}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AccentPink}" />
                                        <Setter Property="Stroke" Value="{StaticResource AccentPink}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Label}" FontSize="12" TextColor="#C8D0E0">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShelfTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="20,0">
                <HorizontalStackLayout Spacing="8">

                    <!-- Clears the language filter; highlighted when nothing is filtered. -->
                    <Border Style="{StaticResource LanguageChip}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsAllLanguages}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="#1AFF4D8D" />
                                <Setter Property="Stroke" Value="{StaticResource AccentPink}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="All languages" FontSize="11" TextColor="#9AA6C0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsAllLanguages}"
                                             Value="True">
                                    <Setter Property="TextColor" Value="#FF7096" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectLanguageCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Languages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MovieLanguage">
                            <Border Style="{StaticResource LanguageChip}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="#1AFF4D8D" />
                                        <Setter Property="Stroke" Value="{StaticResource AccentPink}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Name}" FontSize="11" TextColor="#9AA6C0">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#FF7096" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLanguageTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="{Binding StatusText}"
                   IsVisible="{Binding HasStatus}"
                   TextColor="{StaticResource AccentPink}" FontSize="11" Margin="20,0" />

        </VerticalStackLayout>

        <!-- ═══ GRID ═══ -->
        <RefreshView Grid.Row="4"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource AccentPink}">

            <CollectionView ItemsSource="{Binding Movies}"
                            SelectionMode="None"
                            RemainingItemsThreshold="6"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{OnIdiom Phone=2, Tablet=4, Desktop=6, TV=6}"
                                     HorizontalItemSpacing="12"
                                     VerticalItemSpacing="14" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <BoxView HeightRequest="6" Color="Transparent" />
                </CollectionView.Header>

                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,10,0,24" Spacing="8">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                           IsVisible="{Binding IsLoadingMore}"
                                           Color="{StaticResource AccentPink}" />
                        <Label Text="{Binding StorageText}"
                               FontSize="11" TextColor="#5A6A8E"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="14" Padding="0,60">
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="{StaticResource AccentPink}" Scale="1.3" />
                        <controls:EmptyState
                            IsVisible="{Binding ShowEmptyState}"
                            Icon="{StaticResource IconFilm}"
                            Title="No films found"
                            Hint="Try another title, or pick a language shelf above."
                            Accent="{StaticResource AccentPink}"
                            Margin="20,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MovieCatalogItem">
                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="#1A1A38"
                                BackgroundColor="{StaticResource DeepVoid}">
                            <Border.Behaviors>
                                <helpers:TapScaleBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMovieCardTapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="0">

                                <!-- Poster -->
                                <Grid HeightRequest="210">
                                    <Border StrokeShape="RoundRectangle 16,16,0,0"
                                            StrokeThickness="0"
                                            BackgroundColor="#12122A">
                                        <Image Source="{Binding PosterUrl}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding HasPoster}" />
                                    </Border>

                                    <Border IsVisible="{Binding HasRuntime}"
                                            StrokeShape="RoundRectangle 12,12,0,12"
                                            StrokeThickness="0"
                                            BackgroundColor="#CC0A0A1A"
                                            Padding="8,4"
                                            HorizontalOptions="Start"
                                            VerticalOptions="End"
                                            Margin="8">
                                        <Label Text="{Binding RuntimeLabel}"
                                               FontSize="10" TextColor="White" />
                                    </Border>

                                    <Border IsVisible="{Binding HasDownloadBadge}"
                                            StrokeShape="RoundRectangle 12,12,0,12"
                                            StrokeThickness="0"
                                            BackgroundColor="#CC00A97A"
                                            Padding="8,4"
                                            HorizontalOptions="End"
                                            VerticalOptions="End"
                                            Margin="8">
                                        <Label Text="{Binding DownloadBadge}"
                                               FontSize="10" TextColor="White"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <Border IsVisible="{Binding HasTranslationLabel}"
                                            StrokeShape="RoundRectangle 12,12,0,12"
                                            StrokeThickness="0"
                                            BackgroundColor="#CC8338EC"
                                            Padding="8,4"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            Margin="8">
                                        <Label Text="{Binding TranslationLabel}"
                                               FontSize="10" TextColor="White" />
                                    </Border>
                                </Grid>

                                <!-- Text -->
                                <VerticalStackLayout Padding="12,10,12,12" Spacing="4">
                                    <Label Text="{Binding Title}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasMeta}">
                                        <Label Text="{Binding YearText}" FontSize="11"
                                               TextColor="#8A8A9E"
                                               IsVisible="{Binding HasYear}" />
                                        <Label Text="{Binding LanguageBadge}" FontSize="11"
                                               TextColor="#00D4FF"
                                               IsVisible="{Binding HasLanguageBadge}" />
                                        <Label Text="{Binding SizeText}" FontSize="11"
                                               TextColor="#8A8A9E"
                                               IsVisible="{Binding HasSize}" />
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding DownloadsText}" FontSize="10"
                                           TextColor="#5A6A8E"
                                           IsVisible="{Binding HasDownloads}" />
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>

