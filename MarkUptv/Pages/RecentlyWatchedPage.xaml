<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:Toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MarkUptv.ViewModels"
             xmlns:models="clr-namespace:MarkUptv.Models"
             xmlns:helpers="clr-namespace:MarkUptv.Helpers"
             xmlns:helper="clr-namespace:MarkUptv.Converters"
             xmlns:controls="clr-namespace:MarkUptv.Controls"
             x:Class="MarkUptv.Pages.RecentlyWatchedPage"
             xmlns:views="clr-namespace:MarkUptv.Views"
             x:DataType="vm:RecentlyWatchedViewModel"
             Title="Recently Watched"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0E1A" Offset="0.0"/>
            <GradientStop Color="#121728" Offset="0.5"/>
            <GradientStop Color="#050812" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <helpers:InvertBoolConverter x:Key="InvertBoolConverter" />
        <helpers:StringNullOrEmptyConverter x:Key="StringNullOrEmptyConverter" />
        <helper:IsNotNullConverter x:Key="IsNotNullConverter" />
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" Padding="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Property="RowDefinitions" Value="Auto,Auto,*" />
                        <Setter Property="ColumnDefinitions" Value="*" />
                        <Setter TargetName="PlayerPanel" Property="Grid.Row" Value="0" />
                        <Setter TargetName="PlayerPanel" Property="Grid.Column" Value="0" />
                        <!-- Star row: a '*' inside an Auto parent row collapses,
                             which hid the whole channel list on phones. -->
                        <Setter TargetName="ChannelPanel" Property="Grid.Row" Value="2" />
                        <Setter TargetName="ChannelPanel" Property="Grid.Column" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Property="RowDefinitions" Value="*" />
                        <Setter Property="ColumnDefinitions" Value="2.5*,1.5*" />
                        <Setter TargetName="PlayerPanel" Property="Grid.Row" Value="0" />
                        <Setter TargetName="PlayerPanel" Property="Grid.Column" Value="0" />
                        <Setter TargetName="PlayerPanel" Property="Margin" Value="0,0,16,0" />
                        <Setter TargetName="ChannelPanel" Property="Grid.Row" Value="0" />
                        <Setter TargetName="ChannelPanel" Property="Grid.Column" Value="1" />
                        <Setter TargetName="ChannelPanel" Property="Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="PlayerPanel" RowDefinitions="Auto,*" Margin="0,0,0,12">
            <Border Grid.Row="0" BackgroundColor="#1AFFFFFF" StrokeShape="RoundRectangle 8"
                    Padding="16,10" Stroke="Transparent" Margin="0,0,0,12"
                    IsVisible="{Binding IsPlayerVisible}">
                <Grid ColumnDefinitions="Auto,*">
                    <Ellipse Grid.Column="0" Fill="#E8B54A" WidthRequest="8" HeightRequest="8" 
                             VerticalOptions="Center" Margin="0,0,10,0"
                             IsVisible="{Binding IsPlayerVisible}" />
                    <Label Grid.Column="1" Text="{Binding CurrentChannelName, TargetNullValue='No channel selected'}" 
                           FontSize="16" FontAttributes="Bold" TextTransform="Uppercase"
                           TextColor="White" VerticalOptions="Center" CharacterSpacing="1" />
                </Grid>
            </Border>

            <Border Grid.Row="1" BackgroundColor="#0B0E1A" StrokeShape="RoundRectangle 12"
                    Padding="0" Stroke="#E8B54A" StrokeThickness="1">
                <Grid>
                    <Toolkit:MediaElement x:Name="Player"
                                          Source="{Binding StreamUrl, FallbackValue=''}"
                                          ShouldAutoPlay="True"
                                          ShouldShowPlaybackControls="True"
                                          ShouldKeepScreenOn="True"
                                          IsVisible="{Binding IsPlayerVisible}"
                                          MediaOpened="OnMediaOpened"
                                          MediaFailed="OnMediaFailed" />

                    <ActivityIndicator IsRunning="{Binding IsBuffering}"
                                       IsVisible="{Binding IsBuffering}"
                                       Color="#E8B54A" 
                                       HeightRequest="50" WidthRequest="50"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                    </ActivityIndicator>

                    <VerticalStackLayout IsVisible="{Binding IsPlayerVisible, Converter={StaticResource InvertBoolConverter}}"
                                         VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                        <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32"
                                BackgroundColor="#121728" Stroke="#E8B54A" StrokeThickness="2"
                                HorizontalOptions="Center">
                            <Label Text="🕒" TextColor="#E8B54A" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="WATCH HISTORY" FontSize="20" TextColor="White"
                               HorizontalOptions="Center" FontAttributes="Bold" CharacterSpacing="1.5" />
                        <Label Text="Select a channel from your history to resume."
                               FontSize="14" TextColor="#8B95A6"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ChannelPanel" RowDefinitions="Auto,Auto,Auto,*" Margin="0">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,12">
                <Button Grid.Column="0" Text="Refresh" 
                        Command="{Binding RefreshStreamCommand}"
                        BackgroundColor="#E8B54A" TextColor="#0B0E1A"
                        CornerRadius="22" HeightRequest="44" Padding="18,0"
                        FontSize="13" FontAttributes="Bold" CharacterSpacing="1" />

                <Border Grid.Column="1" BackgroundColor="#1AFFFFFF" StrokeShape="RoundRectangle 8" Stroke="Transparent" HeightRequest="44">
                    <SearchBar Placeholder="Search history..." 
                               Text="{Binding SearchText}"
                               BackgroundColor="Transparent" TextColor="White"
                               PlaceholderColor="#8B95A6" CancelButtonColor="#E8B54A"
                               VerticalOptions="Center" />
                </Border>
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Groups}" 
                            SelectionMode="Single"
                            SelectionChanged="OnGroupSelected" 
                            HeightRequest="40" Margin="0,0,0,12"
                            IsVisible="False">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border StrokeShape="RoundRectangle 20" 
                                BackgroundColor="#121728" Padding="16,0"
                                Stroke="#E8B54A" StrokeThickness="1">
                            <Label Text="{Binding .}" TextColor="#E8B54A" FontSize="13" 
                                   FontAttributes="Bold" TextTransform="Uppercase"
                                   VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}" Color="#E8B54A" 
                               HeightRequest="30" Margin="0,8" />

            <RefreshView Grid.Row="3" IsRefreshing="{Binding IsLoading}" 
                         Command="{Binding RefreshStreamCommand}" RefreshColor="#E8B54A">
                <CollectionView ItemsSource="{Binding RecentlyWatched}" 
                                SelectionMode="Single"
                                SelectionChanged="OnChannelSelected">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=2, Tablet=4, Desktop=6, TV=6}"
                                         HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TvChannel">
                            <!-- Dense 2-up tile: 8 entries per screen instead of 4. -->
                            <views:ChannelTileCard WatchClicked="OnTileWatchClicked" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <!--
                            The mailbox emoji was the only "icon" on this state
                            and the headline shouted in caps. Now it matches
                            every other empty state in the app and offers the
                            refresh it previously assumed the user would find.
                        -->
                        <controls:EmptyState
                            Icon="{StaticResource IconHistory}"
                            Title="No history yet"
                            Hint="Channels you watch will appear here so you can jump straight back in."
                            Accent="{StaticResource Primary}"
                            ActionText="Refresh"
                            ActionCommand="{Binding RefreshStreamCommand}"
                            Margin="16,24" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <Border Grid.Row="3" BackgroundColor="#E63946" StrokeShape="RoundRectangle 8"
                    Padding="12,8" Margin="0,0,0,16" VerticalOptions="End" HorizontalOptions="Center"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" TextColor="White" 
                       FontAttributes="Bold" FontSize="13" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
