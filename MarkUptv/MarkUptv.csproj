    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="4.0.0" />
    <!-- The MediaElement Android platform view resolves its event bus through
         Xamarin.AndroidX.LocalBroadcastManager at view-creation time; without
         an explicit reference the assembly is not packaged and opening any
         page that hosts a MediaElement (e.g. the football screen) aborts the
         process with a FileNotFoundException. -->
    <PackageReference Include="Xamarin.AndroidX.LocalBroadcastManager" Version="1.1.0.10" Condition="'$(TargetFramework)' == 'net10.0-android'" />
	<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
	<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
	<PackageReference Include="Microsoft.Maui.Core" Version="10.0.10" />
	<PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.5" Condition="'$(TargetFramework)' == 'net10.0-android'" />
	<PackageReference Include="System.Text.Json" Version="10.0.8" />
		
  </ItemGroup>

