	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Resources\Platforms\**\*.cs" />
		<Compile Remove="Resources\Helpers\**\*.cs" />
		<MauiXaml Remove="Resources\Platforms\**\*.xaml" />
		<None Include="Resources\Platforms\**\*" Exclude="Resources\Platforms\**\*.cs;Resources\Platforms\**\*.xaml" />
		<None Include="Resources\Helpers\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon (full-bleed design; foreground keeps the artwork inside
		     the Android adaptive safe zone) -->
		<MauiIcon Include="Resources\AppIcon\markuptv_appicon.svg" ForegroundFile="Resources\AppIcon\markuptv_appiconfg.svg" Color="#070D26" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\markuptvsplash.svg" Color="#0B0E1A" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\markputvlogo.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		
	</ItemGroup>

