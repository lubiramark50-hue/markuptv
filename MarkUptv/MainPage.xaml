                                                    Text="{Binding Icon}"
                                                    FontSize="{OnIdiom Phone=17, Tablet=19, Desktop=23, TV=29}"
                                                    TextColor="{StaticResource DiamondGold}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />

                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Row="1"
                                                Spacing="1"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding Title}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Text="{Binding Subtitle}"
                                                    FontSize="10"
                                                    TextColor="{StaticResource MutedText}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Row="2"
                                                Text="Open section ›"
                                                FontSize="9"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource DiamondGold}" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </FlexLayout>

                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </DataTemplate>

                            <DataTemplate x:Key="DashboardChunk5" x:DataType="vm:MainPageViewModel">

                                <VerticalStackLayout Spacing="24">

                    <!-- Continue watching -->

                    <VerticalStackLayout
                        Spacing="13"
                        IsVisible="{Binding HasRecentlyWatched}">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="1">

                                <Label
                                    Text="Continue watching"
                                    Style="{StaticResource SectionTitleStyle}" />

                                <Label
                                    Text="Resume your recent channels."
                                    Style="{StaticResource SectionCaptionStyle}" />

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="History"
                                Command="{Binding GoToRecentlyWatchedCommand}"
                                Clicked="OnAnimatedButtonClicked"
                                Style="{StaticResource GlassButtonStyle}" />

                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding RecentlyWatchedChannels}"
                            HeightRequest="160"
                            SelectionMode="None"
                            HorizontalScrollBarVisibility="Never">

                            <CollectionView.ItemsLayout>

                                <LinearItemsLayout
                                    Orientation="Horizontal"
                                    ItemSpacing="12" />

                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:TvChannel">

                                    <Border
                                        WidthRequest="185"
                                        Style="{StaticResource DiamondCardStyle}">

                                        <Border.Behaviors>
                                            <helpers:TapScaleBehavior/>
                                        </Border.Behaviors>
                                        <Border.GestureRecognizers>                                        <TapGestureRecognizer
                                            Tapped="OnRecentChannelTapped"
                                            CommandParameter="{Binding .}" />

                                        </Border.GestureRecognizers>

                                        <Grid
                                            IsClippedToBounds="True"
                                            InputTransparent="True"
                                            CascadeInputTransparent="True">

                                            <Image
                                                Source="{Binding LogoUrl}"
                                                Aspect="AspectFill"
                                                Opacity="0.50" />

                                            <BoxView
                                                Color="{StaticResource DeepVoid}"
                                                Opacity="0.52" />

                                            <VerticalStackLayout
                                                Padding="13"
                                                Spacing="5"
                                                VerticalOptions="End">

                                                <Label
                                                    Text="{Binding Name}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation" />

                                                <HorizontalStackLayout Spacing="5">

                                                    <Label
                                                        Text="▶"
                                                        FontSize="11"
                                                        TextColor="{StaticResource DiamondGold}" />

                                                    <Label
                                                        Text="Resume"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="White" />

                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </DataTemplate>

                            <DataTemplate x:Key="DashboardChunk6" x:DataType="vm:MainPageViewModel">

                                <VerticalStackLayout Spacing="24">

                    <!-- Community preview -->

                    <VerticalStackLayout
                        Spacing="13"
                        IsVisible="{Binding HasSocialPreview}">

                        <Grid
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="8">

                            <VerticalStackLayout Spacing="1">

                                <Label
                                    Text="Community pulse"
                                    Style="{StaticResource SectionTitleStyle}" />

                                <Label
                                    Text="Live reactions from MarkUpTV viewers."
                                    Style="{StaticResource SectionCaptionStyle}" />

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="New post"
                                Command="{Binding OpenComposePostCommand}"
                                Clicked="OnAnimatedButtonClicked"
                                Style="{StaticResource GlassButtonStyle}" />

                            <Button
                                Grid.Column="2"
                                Text="Open"
                                Command="{Binding GoToSocialCommand}"
                                Clicked="OnAnimatedButtonClicked"
                                Style="{StaticResource DiamondButtonStyle}" />

                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding SocialPostsPreview}"
                            HeightRequest="{OnIdiom Phone=195,
                                                    Tablet=205,
                                                    Desktop=215,
                                                    TV=250}"
                            SelectionMode="None"
                            HorizontalScrollBarVisibility="Never">

                            <CollectionView.ItemsLayout>

                                <LinearItemsLayout
                                    Orientation="Horizontal"
                                    ItemSpacing="12" />

                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:SocialPost">

                                    <Border
                                        WidthRequest="{OnIdiom Phone=275,
                                                               Tablet=310,
                                                               Desktop=350,
                                                               TV=430}"
                                        Padding="15"
                                        Style="{StaticResource DiamondCardStyle}">

                                        <Border.Behaviors>
                                            <helpers:TapScaleBehavior/>
                                        </Border.Behaviors>
                                        <Border.GestureRecognizers>                                        <TapGestureRecognizer
                                            Tapped="OnSocialPostTapped"
                                            CommandParameter="{Binding .}" />

                                        </Border.GestureRecognizers>

                                        <Grid
                                            InputTransparent="True"
                                            CascadeInputTransparent="True"
                                            RowDefinitions="Auto,*,Auto"
                                            RowSpacing="10">

                                            <Grid
                                                ColumnDefinitions="43,*,Auto"
                                                ColumnSpacing="9">

                                                <Border
                                                    WidthRequest="43"
                                                    HeightRequest="43"
                                                    Background="{StaticResource DiamondBrandBrush}"
                                                    Stroke="#50FFFFFF"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 14">

                                                    <Label
                                                        Text="{Binding AuthorInitial}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />

                                                </Border>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="1"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding AuthorName}"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        MaxLines="1"
                                                        LineBreakMode="TailTruncation" />

                                                    <Label
                                                        Text="{Binding TimeAgo}"
                                                        FontSize="10"
                                                        TextColor="{StaticResource MutedText}" />

                                                </VerticalStackLayout>

                                                <Label
                                                    Grid.Column="2"
                                                    Text="{Binding LikeIcon}"
                                                    FontSize="16"
                                                    VerticalOptions="Center" />

                                            </Grid>

                                            <Label
                                                Grid.Row="1"
                                                Text="{Binding Content}"
                                                FontSize="13"
                                                TextColor="#D8DDF4"
                                                MaxLines="3"
                                                LineBreakMode="TailTruncation" />

                                            <HorizontalStackLayout
                                                Grid.Row="2"
                                                Spacing="5">

                                                <Label
                                                    Text="Open post"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource DiamondGold}" />

                                                <Label
                                                    Text="›"
                                                    FontSize="16"
                                                    TextColor="White" />

                                            </HorizontalStackLayout>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </DataTemplate>

                            <DataTemplate x:Key="DashboardChunk7" x:DataType="vm:MainPageViewModel">

                                <VerticalStackLayout Spacing="24">

                    <!-- News -->

                    <VerticalStackLayout Spacing="13">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="1">

                                <Label
                                    Text="Latest stories"
                                    Style="{StaticResource SectionTitleStyle}" />

                                <Label
                                    Text="Fresh headlines from around the world."
                                    Style="{StaticResource SectionCaptionStyle}" />

                            </VerticalStackLayout>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="9"
                                VerticalOptions="Center">

                                <Border
                                    Padding="13,0"
                                    HeightRequest="40"
                                    BackgroundColor="#16FFFFFF"
                                    Stroke="#55E8B54A"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    IsVisible="{Binding IsNewsVisible}">

                                    <HorizontalStackLayout
                                        Spacing="7"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">

                                        <Path
                                            Data="M12,1.6 L22.4,12 L12,22.4 L1.6,12 Z"
                                            Aspect="Uniform"
                                            WidthRequest="8"
                                            HeightRequest="8"
                                            Fill="{StaticResource DiamondGold}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="{Binding NewsItems.Count}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="stories"
                                            FontSize="11"
                                            TextColor="{StaticResource MutedText}"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                                <Button
                                    Text="Refresh"
                                    Command="{Binding RefreshNewsCommand}"
                                    Clicked="OnAnimatedButtonClicked"
                                    Style="{StaticResource GlassButtonStyle}" />

                            </HorizontalStackLayout>

                        </Grid>

                        <!-- News loading -->

                        <Border
                            Padding="17"
                            BackgroundColor="#12FFFFFF"
                            Stroke="#28FFFFFF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 17"
                            IsVisible="{Binding IsNewsLoading}">

                            <HorizontalStackLayout
                                Spacing="11"
                                HorizontalOptions="Center">

                                <ActivityIndicator
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    IsRunning="{Binding IsNewsLoading}"
                                    Color="{StaticResource DiamondGold}" />

                                <VerticalStackLayout
                                    Spacing="1"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="Collecting headlines"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label
                                        Text="Searching the news universe..."
                                        FontSize="10"
                                        TextColor="{StaticResource MutedText}" />

                                </VerticalStackLayout>

                            </HorizontalStackLayout>

                        </Border>

                        <!-- News error -->

                        <Border
                            Padding="18"
                            BackgroundColor="#D09A1D47"
                            Stroke="#FFFFAFC4"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            IsVisible="{Binding HasNewsError}">

                            <VerticalStackLayout
                                Spacing="8"
                                HorizontalOptions="Center">

                                <Label
                                    Text="◇"
                                    FontSize="45"
                                    TextColor="White"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="{Binding NewsErrorMessage}"
                                    FontSize="12"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center" />

                                <Button
                                    Text="Try again"
                                    Command="{Binding RefreshNewsCommand}"
                                    Clicked="OnAnimatedButtonClicked"
                                    Style="{StaticResource DiamondButtonStyle}" />

                            </VerticalStackLayout>

                        </Border>

                        <!-- News empty -->

                        <Border
                            Padding="20"
                            BackgroundColor="#12FFFFFF"
                            Stroke="#28FFFFFF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            IsVisible="{Binding IsNewsEmpty}">

                            <VerticalStackLayout Spacing="7">

                                <Label
                                    Text="◇"
                                    FontSize="48"
                                    TextColor="{StaticResource DiamondPurple}"
                                    HorizontalOptions="Center" />

                                <Label
                                    Text="No stories are available right now."
                                    FontSize="13"
                                    TextColor="{StaticResource MutedText}"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Border>

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding NewsItems}"
                            Spacing="12"
                            IsVisible="{Binding IsNewsVisible}">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:NewsArticle">

                                    <Border
                                        Padding="8"
                                        Style="{StaticResource DiamondCardStyle}">

                                        <Border.Behaviors>
                                            <helpers:TapScaleBehavior/>
                                        </Border.Behaviors>
                                        <Border.GestureRecognizers>                                        <TapGestureRecognizer
                                            Tapped="OnNewsItemTapped"
                                            CommandParameter="{Binding .}" />

                                        </Border.GestureRecognizers>

                                        <Grid
                                            InputTransparent="True"
                                            CascadeInputTransparent="True"
                                            ColumnDefinitions="{OnIdiom Phone='118,*',
                                                                       Tablet='160,*',
                                                                       Desktop='200,*',
                                                                       TV='252,*'}"
                                            ColumnSpacing="14">

                                            <Border
                                                Grid.Column="0"
                                                HeightRequest="{OnIdiom Phone=132,
                                                                       Tablet=156,
                                                                       Desktop=176,
                                                                       TV=218}"
                                                BackgroundColor="#080A19"
                                                Stroke="#26FFFFFF"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 17">

                                                <Grid>

                                                    <Label
                                                        Text="◆"
                                                        FontSize="48"
                                                        TextColor="#2AFFFFFF"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />

                                                    <Image
                                                        Source="{Binding ImageUrl}"
                                                        Aspect="AspectFill" />

                                                    <BoxView
                                                        Color="#03050E"
                                                        Opacity="0.08" />

                                                    <Border
                                                        Margin="8"
                                                        Padding="9,4"
                                                        BackgroundColor="#E6A8771F"
                                                        Stroke="#A0FFFFFF"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 9"
                                                        HorizontalOptions="Start"
                                                        VerticalOptions="Start">

                                                        <Label
                                                            Text="NEWS"
                                                            FontSize="8.5"
                                                            FontAttributes="Bold"
                                                            CharacterSpacing="1.4"
                                                            TextColor="White" />

                                                    </Border>

                                                    <Border
                                                        WidthRequest="44"
                                                        HeightRequest="44"
                                                        Padding="0"
                                                        BackgroundColor="#B304060F"
                                                        Stroke="#C8FFFFFF"
                                                        StrokeThickness="1.5"
                                                        StrokeShape="RoundRectangle 22"
                                                        IsVisible="False"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">

                                                        <Border.Triggers>

                                                            <DataTrigger
                                                                TargetType="Border"
                                                                Binding="{Binding MediaType}"
                                                                Value="Video">
                                                                <Setter Property="IsVisible" Value="True" />
                                                            </DataTrigger>

                                                        </Border.Triggers>

                                                        <Label
                                                            Text="▶"
                                                            FontSize="17"
                                                            Margin="2,0,0,0"
                                                            TextColor="White"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />

                                                    </Border>

                                                </Grid>

                                            </Border>

                                            <Grid
                                                Grid.Column="1"
                                                Padding="1,9,10,8"
                                                RowDefinitions="Auto,Auto,*,Auto"
                                                RowSpacing="6">

                                                <HorizontalStackLayout
                                                    Grid.Row="0"
                                                    Spacing="7">

                                                    <Label
                                                        Text="●"
                                                        FontSize="7"
                                                        TextColor="{StaticResource DiamondBlue}"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Text="{Binding Source}"
                                                        FontSize="10.5"
                                                        FontAttributes="Bold"
                                                        CharacterSpacing="0.3"
                                                        TextColor="{StaticResource DiamondPink}"
                                                        MaxLines="1"
                                                        LineBreakMode="TailTruncation" />

                                                    <Path
                                                        Data="M12,1.6 L22.4,12 L12,22.4 L1.6,12 Z"
                                                        Aspect="Uniform"
                                                        WidthRequest="6"
                                                        HeightRequest="6"
                                                        Fill="{StaticResource DiamondGold}"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Text="{Binding TimeAgo}"
                                                        FontSize="10"
                                                        TextColor="{StaticResource MutedText}"
                                                        VerticalOptions="Center" />

                                                </HorizontalStackLayout>

                                                <Label
                                                    Grid.Row="1"
                                                    Text="{Binding Title}"
                                                    FontSize="{OnIdiom Phone=15,
                                                                       Tablet=17,
                                                                       Desktop=18.5,
                                                                       TV=23}"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    MaxLines="2"
                                                    LineBreakMode="TailTruncation" />

                                                <Label
                                                    Grid.Row="2"
                                                    Text="{Binding Description}"
                                                    FontSize="{OnIdiom Phone=11,
                                                                       Tablet=12,
                                                                       Desktop=13,
                                                                       TV=16}"
                                                    TextColor="#BCC4DF"
                                                    MaxLines="2"
                                                    LineBreakMode="TailTruncation"
                                                    VerticalOptions="Start" />

                                                <HorizontalStackLayout
                                                    Grid.Row="3"
                                                    Spacing="9">

                                                    <Border
                                                        Padding="12,5"
                                                        BackgroundColor="#22A8771F"
                                                        Stroke="#55A8771F"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 10">

                                                        <Border.Triggers>

                                                            <DataTrigger
                                                                TargetType="Border"
                                                                Binding="{Binding MediaType}"
                                                                Value="Video">
                                                                <Setter Property="BackgroundColor" Value="#22E8B54A" />
                                                                <Setter Property="Stroke" Value="#66E8B54A" />
                                                            </DataTrigger>

                                                        </Border.Triggers>

                                                        <HorizontalStackLayout
                                                            Spacing="6"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center">

                                                            <Label
                                                                Text="▶"
                                                                FontSize="9"
                                                                FontAttributes="Bold"
                                                                TextColor="#9CC3FF"
                                                                IsVisible="False"
                                                                VerticalOptions="Center">

                                                                <Label.Triggers>

                                                                    <DataTrigger
                                                                        TargetType="Label"
                                                                        Binding="{Binding MediaType}"
                                                                        Value="Video">
                                                                        <Setter Property="IsVisible" Value="True" />
                                                                    </DataTrigger>

                                                                </Label.Triggers>

                                                            </Label>

                                                            <Label
                                                                Text="READ STORY"
                                                                FontSize="9.5"
                                                                FontAttributes="Bold"
                                                                CharacterSpacing="0.9"
                                                                TextColor="#9CC3FF">

                                                                <Label.Triggers>

                                                                    <DataTrigger
                                                                        TargetType="Label"
                                                                        Binding="{Binding MediaType}"
                                                                        Value="Video">
                                                                        <Setter Property="Text" Value="WATCH" />
                                                                        <Setter Property="TextColor" Value="#FFD9A0" />
                                                                    </DataTrigger>

                                                                </Label.Triggers>

                                                            </Label>

                                                        </HorizontalStackLayout>

                                                    </Border>

                                                    <Label
                                                        Text="›"
                                                        FontSize="15"
                                                        TextColor="{StaticResource DiamondGold}"
                                                        VerticalOptions="Center" />

                                                </HorizontalStackLayout>

                                            </Grid>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                        <!-- Load more -->

                        <Button
                            Text="Load more stories"
                            Command="{Binding LoadMoreNewsCommand}"
                            Clicked="OnAnimatedButtonClicked"
                            IsVisible="{Binding CanLoadMoreNews}"
                            Style="{StaticResource GlassButtonStyle}"
                            HorizontalOptions="Center" />

                        <HorizontalStackLayout
                            IsVisible="{Binding IsLoadingMore}"
                            Spacing="9"
                            HorizontalOptions="Center">

                            <ActivityIndicator
                                WidthRequest="26"
                                HeightRequest="26"
                                IsRunning="{Binding IsLoadingMore}"
                                Color="{StaticResource DiamondGold}" />

                            <Label
                                Text="Loading more stories..."
                                FontSize="11"
                                TextColor="{StaticResource MutedText}"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </DataTemplate>

                            <DataTemplate x:Key="DashboardChunk8" x:DataType="vm:MainPageViewModel">

                                <VerticalStackLayout Spacing="24">

                    <!-- General error -->

                    <Border
                        Padding="13,10"
                        BackgroundColor="#D0B3123F"
                        Stroke="#FFFFAFC2"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 15"
                        IsVisible="{Binding HasError}">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Text="⚠"
                                FontSize="20"
                                TextColor="White"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding ErrorMessage}"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="White"
                                MaxLines="3"
                                LineBreakMode="WordWrap"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                                </VerticalStackLayout>

                            </DataTemplate>

                        </ContentView.Resources>

                        <VerticalStackLayout x:Name="DashboardChunkStack" Spacing="24" />

                    </ContentView>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

        <!-- Advertisement -->

        <ContentView
            x:Name="BannerContainer"
            Grid.Row="1"
            HeightRequest="50"
            WidthRequest="320"
            Margin="0,0,0,12"
            HorizontalOptions="Center" />

        <!-- AI Chat Modal: lazily inflated the first time the user opens chat. -->
        <ContentView
            x:Name="AiChatModalHost"
            Grid.Row="0"
            Grid.RowSpan="2"
            ZIndex="999"
            IsVisible="{Binding IsChatOpen}" />


    </Grid>

</ContentPage>
