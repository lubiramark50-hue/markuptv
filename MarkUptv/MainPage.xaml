<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MarkUptv.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:MarkUptv.Helpers"
    xmlns:conv="clr-namespace:MarkUptv.Converters"
    xmlns:models="clr-namespace:MarkUptv.Models"
    xmlns:vm="clr-namespace:MarkUptv.ViewModels"
    x:Name="PageRoot"
    x:DataType="vm:MainPageViewModel"
    Title="Home"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- Colours -->

        <Color x:Key="DeepSky">#0B0E1A</Color>
        <Color x:Key="MidnightPanel">#121728</Color>
        <Color x:Key="RaisedPanel">#1A2138</Color>
        <Color x:Key="DiamondWhite">#EEF3FB</Color>
        <Color x:Key="DiamondGold">#E8B54A</Color>
        <!-- The accent pair used to be cyan (#E8B54A twice). Cyan
             against the navy surfaces read as an unrelated stock
             "tech blue"; both are the brand gold now. -->

        <Color x:Key="DiamondBlue">#E8B54A</Color>
        <Color x:Key="DiamondPurple">#F2C879</Color>
        <Color x:Key="DiamondPink">#FF4D8D</Color>
        <Color x:Key="MutedText">#93A0BF</Color>
        <Color x:Key="GlassBorder">#30FFFFFF</Color>

        <LinearGradientBrush
            x:Key="PageSkyBrush"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="{StaticResource DeepVoid}"
                Offset="0" />

            <GradientStop
                Color="#10152B"
                Offset="0.46" />

            <GradientStop
                Color="#0E1220"
                Offset="1" />

        </LinearGradientBrush>

        <LinearGradientBrush
            x:Key="DiamondBrandBrush"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#F7D98A"
                Offset="0" />

            <GradientStop
                Color="#E8B54A"
                Offset="0.50" />

            <GradientStop
                Color="#B8862B"
                Offset="1" />

        </LinearGradientBrush>

        <!-- Sky gradient for the AI chat surface (shared with AppShell) -->

        <LinearGradientBrush
            x:Key="DiamondSkyBrush"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#101726"
                Offset="0" />

            <GradientStop
                Color="#0F1D2E"
                Offset="0.46" />

            <GradientStop
                Color="#0C2230"
                Offset="1" />

        </LinearGradientBrush>

        <!-- Dashboard feature icons -->

        <conv:FeatureIconConverter x:Key="FeatureIcon" />

        <!-- AI chat converters -->

        <conv:RoleToVisibleConverter x:Key="RoleToVisibleConverter" />
        <conv:RoleToBgConverter x:Key="RoleToBgConverter" />
        <conv:RoleToStrokeConverter x:Key="RoleToStrokeConverter" />
        <conv:RoleToAlignmentConverter x:Key="RoleToAlignmentConverter" />
        <conv:CountGreaterThanZeroConverter x:Key="CountGreaterThanZeroConverter" />
        <conv:MarkdownConverter x:Key="MarkdownConverter" />
        <helpers:InvertBoolConverter x:Key="NotBoolConverter" />

        <LinearGradientBrush
            x:Key="HeroBrush"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#16233B"
                Offset="0" />

            <GradientStop
                Color="#111A30"
                Offset="0.52" />

            <GradientStop
                Color="#0D1120"
                Offset="1" />

        </LinearGradientBrush>

        <LinearGradientBrush
            x:Key="LiveMatchBrush"
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="{StaticResource AccentPink}"
                Offset="0" />

            <GradientStop
                Color="#8D174A"
                Offset="0.55" />

            <GradientStop
                Color="#3B163F"
                Offset="1" />

        </LinearGradientBrush>

        <!-- Section text -->

        <Style
            x:Key="SectionTitleStyle"
            TargetType="Label">

            <Setter
                Property="FontSize"
                Value="20" />

            <Setter
                Property="FontAttributes"
                Value="Bold" />

            <Setter
                Property="CharacterSpacing"
                Value="0.4" />

            <Setter
                Property="TextColor"
                Value="White" />

        </Style>

        <Style
            x:Key="SectionCaptionStyle"
            TargetType="Label">

            <Setter
                Property="FontSize"
                Value="12" />

            <Setter
                Property="TextColor"
                Value="{StaticResource MutedText}" />

        </Style>

        <!-- Buttons -->

        <Style
            x:Key="DiamondButtonStyle"
            TargetType="Button">

            <Setter
                Property="HeightRequest"
                Value="43" />

            <Setter
                Property="Padding"
                Value="17,0" />

            <Setter
                Property="CornerRadius"
                Value="14" />

            <Setter
                Property="FontAttributes"
                Value="Bold" />

            <Setter
                Property="CharacterSpacing"
                Value="0.5" />

            <Setter
                Property="FontSize"
                Value="12" />

            <Setter
                Property="BackgroundColor"
                Value="{StaticResource DiamondPurple}" />

            <Setter
                Property="TextColor"
                Value="White" />

            <Setter
                Property="BorderColor"
                Value="#55FFFFFF" />

            <Setter
                Property="BorderWidth"
                Value="1" />

        </Style>

        <Style
            x:Key="GlassButtonStyle"
            TargetType="Button">

            <Setter
                Property="HeightRequest"
                Value="40" />

            <Setter
                Property="Padding"
                Value="15,0" />

            <Setter
                Property="CornerRadius"
                Value="14" />

            <Setter
                Property="FontAttributes"
                Value="Bold" />

            <Setter
                Property="CharacterSpacing"
                Value="0.5" />

            <Setter
                Property="FontSize"
                Value="12" />

            <Setter
                Property="BackgroundColor"
                Value="#14FFFFFF" />

            <Setter
                Property="TextColor"
                Value="White" />

            <Setter
                Property="BorderColor"
                Value="#28FFFFFF" />

            <Setter
                Property="BorderWidth"
                Value="1" />

        </Style>

        <!-- Cards -->

        <Style
            x:Key="DiamondCardStyle"
            TargetType="Border">

            <Setter
                Property="BackgroundColor"
                Value="#DD111731" />

            <Setter
                Property="Stroke"
                Value="#2AFFFFFF" />

            <Setter
                Property="StrokeThickness"
                Value="1" />

            <Setter
                Property="StrokeShape"
                Value="RoundRectangle 21" />

            <Setter
                Property="Scale"
                Value="1" />

            <Setter
                Property="VisualStateManager.VisualStateGroups">

                <VisualStateGroupList>

                    <VisualStateGroup
                        x:Name="CommonStates">

                        <VisualState
                            x:Name="Normal" />

                        <VisualState
                            x:Name="PointerOver">

                            <VisualState.Setters>

                                <Setter
                                    Property="Stroke"
                                    Value="{StaticResource DiamondBlue}" />

                                <Setter
                                    Property="Scale"
                                    Value="1.018" />

                            </VisualState.Setters>

                        </VisualState>

                        <VisualState
                            x:Name="Focused">

                            <VisualState.Setters>

                                <Setter
                                    Property="Stroke"
                                    Value="{StaticResource DiamondGold}" />

                                <Setter
                                    Property="Scale"
                                    Value="1.025" />

                            </VisualState.Setters>

                        </VisualState>

                    </VisualStateGroup>

                </VisualStateGroupList>

            </Setter>

        </Style>


        <!-- AI chat modal: inflated on demand (see EnsureAiChatModal in the
             code-behind). Kept out of the eager InitializeComponent pass. -->
        <DataTemplate x:Key="AiChatModalTemplate" x:DataType="vm:MainPageViewModel">

        <Border
            x:Name="AiChatModal"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsChatOpen}"
            Padding="0"
            Margin="0"
            Background="#D504060F"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 0"
            ZIndex="999">

            <Grid
                RowDefinitions="*,Auto"
                Margin="{OnIdiom Phone='0',
                                       Tablet='30,25,30,25',
                                       Desktop='80,40,80,40',
                                       TV='150,80,150,80'}">

                <Grid.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding CloseChatCommand}" />

                </Grid.GestureRecognizers>

                <!-- Chat Card -->

                <Border
                    Grid.RowSpan="2"
                    Margin="0"
                    Padding="0"
                    Background="{StaticResource DiamondSkyBrush}"
                    Stroke="{StaticResource GlassBorder}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 26"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding ToggleChatCommand}" />

                    </Border.GestureRecognizers>

                    <Border.Shadow>

                        <Shadow
                            Brush="#A0E8B54A"
                            Offset="0,18"
                            Radius="40"
                            Opacity="0.65" />

                    </Border.Shadow>

                    <Grid
                        RowDefinitions="Auto,*,Auto,Auto"
                        IsClippedToBounds="True"
                        InputTransparent="False">

                        <!-- Modal Header -->

                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12"
                            Padding="18,13,16,13"
                            Background="#1AFFFFFF">

                            <Border
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="5"
                                Background="{StaticResource DiamondBrandBrush}"
                                Stroke="#70FFFFFF"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 15">

                                <Border.Shadow>

                                    <Shadow
                                        Brush="#55E8B54A"
                                        Offset="0,5"
                                        Radius="10"
                                        Opacity="0.6" />

                                </Border.Shadow>

                                <Grid InputTransparent="True">

                                    <Path
                                        Data="M12 1 L14.4 9.6 L23 12 L14.4 14.4 L12 23 L9.6 14.4 L1 12 L9.6 9.6 Z"
                                        Aspect="Uniform"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        Fill="White"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">

                                <Label
                                    Text="MarkUp AI Assistant"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    CharacterSpacing="0.3"
                                    TextColor="White" />

                                <HorizontalStackLayout
                                    Spacing="6"
                                    VerticalOptions="Center">

                                    <Border
                                        Padding="8,3"
                                        BackgroundColor="#1A5CFF88"
                                        Stroke="#3A5CFF88"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 9"
                                        VerticalOptions="Center">

                                        <HorizontalStackLayout Spacing="5">

                                            <Border
                                                WidthRequest="6"
                                                HeightRequest="6"
                                                BackgroundColor="#5CFF88"
                                                Stroke="White"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 3"
                                                VerticalOptions="Center" />

                                            <Label
                                                Text="ONLINE"
                                                FontSize="7.5"
                                                FontAttributes="Bold"
                                                CharacterSpacing="1.2"
                                                TextColor="#7DE8A8"
                                                VerticalOptions="Center" />

                                        </HorizontalStackLayout>

                                    </Border>

                                    <Label
                                        Text="Ready to help"
                                        FontSize="10"
                                        TextColor="{StaticResource MutedText}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                Text="✕"
                                FontSize="15"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0"
                                CornerRadius="15"
                                BackgroundColor="#1BFFFFFF"
                                TextColor="White"
                                BorderColor="#3AFFFFFF"
                                BorderWidth="1"
                                VerticalOptions="Center"
                                Clicked="OnAnimatedButtonClicked"
                                Command="{Binding CloseChatCommand}" />

                        </Grid>

                        <!-- Chat Messages -->

                        <ScrollView
                            Grid.Row="1"
                            x:Name="AiChatScroll"
                            Padding="17,14"
                            Background="#08FFFFFF">

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding AiChatMessages}"
                                Spacing="11">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate x:DataType="models:AiChatMessage">

                                        <Grid
                                            ColumnDefinitions="{OnIdiom Phone='Auto,*',
                                                                           Tablet='Auto,*',
                                                                           Desktop='Auto,*,*',
                                                                           TV='Auto,*,*'}"
                                            ColumnSpacing="10">

                                            <Border
                                                IsVisible="{Binding Converter={StaticResource RoleToVisibleConverter},
                                                                    ConverterParameter=Assistant}"
                                                Grid.Column="0"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                Background="{StaticResource DiamondBrandBrush}"
                                                Stroke="#60FFFFFF"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 11"
                                                VerticalOptions="Start">

                                                <Path
                                                    Data="M12 1 L14.4 9.6 L23 12 L14.4 14.4 L12 23 L9.6 14.4 L1 12 L9.6 9.6 Z"
                                                    Aspect="Uniform"
                                                    WidthRequest="16"
                                                    HeightRequest="16"
                                                    Fill="White"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />

                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                Padding="13,11"
                                                BackgroundColor="{Binding Converter={StaticResource RoleToBgConverter}}"
                                                Stroke="{Binding Converter={StaticResource RoleToStrokeConverter}}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 17"
                                                HorizontalOptions="{Binding Converter={StaticResource RoleToAlignmentConverter}}"
                                                MaximumWidthRequest="{OnIdiom Phone='310',
                                                                              Tablet='470',
                                                                              Desktop='600',
                                                                              TV='760'}">

                                                <VerticalStackLayout Spacing="9">

                                                    <Grid IsVisible="{Binding IsTyping}">

                                                        <HorizontalStackLayout
                                                            Spacing="5"
                                                            HorizontalOptions="Start">

                                                            <Label
                                                                Text="●"
                                                                FontSize="10"
                                                                TextColor="{StaticResource DiamondGold}">
                                                                <Label.Triggers>
                                                                    <DataTrigger
                                                                        TargetType="Label"
                                                                        Binding="{Binding IsTyping}"
                                                                        Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <helpers:AnimateTypingAction />
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>

                                                            <Label
                                                                Text="●"
                                                                FontSize="10"
                                                                TextColor="{StaticResource DiamondPurple}">
                                                                <Label.Triggers>
                                                                    <DataTrigger
                                                                        TargetType="Label"
                                                                        Binding="{Binding IsTyping}"
                                                                        Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <helpers:AnimateTypingAction Delay="150"/>
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>

                                                            <Label
                                                                Text="●"
                                                                FontSize="10"
                                                                TextColor="{StaticResource DiamondPink}">
                                                                <Label.Triggers>
                                                                    <DataTrigger
                                                                        TargetType="Label"
                                                                        Binding="{Binding IsTyping}"
                                                                        Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <helpers:AnimateTypingAction Delay="300"/>
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>

                                                        </HorizontalStackLayout>

                                                    </Grid>

                                                    <Label
                                                        Text="{Binding Text, Converter={StaticResource MarkdownConverter}}"
                                                        FontSize="13"
                                                        TextColor="White"
                                                        TextType="Html"
                                                        IsVisible="{Binding IsTyping, Converter={StaticResource NotBoolConverter}}" />

                                                    <!-- Chat Action Bar -->
                                                    <HorizontalStackLayout 
                                                        Spacing="10" 
                                                        HorizontalOptions="End"
                                                        IsVisible="{Binding IsTyping, Converter={StaticResource NotBoolConverter}}">
                                                        <Button
                                                            Text="📋"
                                                            FontSize="12"
                                                            HeightRequest="24"
                                                            WidthRequest="30"
                                                            Padding="0"
                                                            CornerRadius="4"
                                                            BackgroundColor="#1AFFFFFF"
                                                            TextColor="White"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, Path=CopyMessageCommand}"
                                                            CommandParameter="{Binding Text}"
                                                            ToolTipProperties.Text="Copy Message" />
                                                    </HorizontalStackLayout>

                                                    <VerticalStackLayout
                                                        Spacing="8"
                                                        BindableLayout.ItemsSource="{Binding Recommendations}"
                                                        IsVisible="{Binding Path=Recommendations.Count,
                                                                            Converter={StaticResource CountGreaterThanZeroConverter}}">

                                                        <BindableLayout.ItemTemplate>

                                                            <DataTemplate x:DataType="models:AiRecommendedChannel">

                                                                <Border
                                                                    Padding="10"
                                                                    BackgroundColor="#18FFFFFF"
                                                                    Stroke="#33FFFFFF"
                                                                    StrokeThickness="1"
                                                                    StrokeShape="RoundRectangle 14">

                                                                    <Border.Behaviors>
                                                                        <helpers:TapScaleBehavior/>
                                                                    </Border.Behaviors>
                                                                    <Border.GestureRecognizers>

                                                                        <TapGestureRecognizer
                                                                            Tapped="OnAiRecommendedChannelTapped"
                                                                            CommandParameter="{Binding .}" />

                                                                    </Border.GestureRecognizers>

                                                                    <Grid
                                                                        ColumnDefinitions="Auto,*,Auto"
                                                                        ColumnSpacing="10"
                                                                        InputTransparent="True"
                                                                        CascadeInputTransparent="True">

                                                                        <Border
                                                                            WidthRequest="46"
                                                                            HeightRequest="46"
                                                                            BackgroundColor="#0B0D1B"
                                                                            Stroke="#30FFFFFF"
                                                                            StrokeThickness="1"
                                                                            StrokeShape="RoundRectangle 12">

                                                                            <Grid>

                                                                                <Label
                                                                                    Text="◆"
                                                                                    FontSize="24"
                                                                                    TextColor="#25FFFFFF"
                                                                                    HorizontalOptions="Center"
                                                                                    VerticalOptions="Center" />

                                                                                <Image
                                                                                    Source="{Binding LogoUrl}"
                                                                                    Aspect="AspectFit"
                                                                                    Margin="5" />

                                                                            </Grid>

                                                                        </Border>

                                                                        <VerticalStackLayout
                                                                            Grid.Column="1"
                                                                            Spacing="1"
                                                                            VerticalOptions="Center">

                                                                            <Label
                                                                                Text="{Binding Name}"
                                                                                FontSize="13"
                                                                                FontAttributes="Bold"
                                                                                TextColor="White"
                                                                                MaxLines="1"
                                                                                LineBreakMode="TailTruncation" />

                                                                            <Label
                                                                                Text="{Binding CurrentProgramme}"
                                                                                FontSize="10"
                                                                                TextColor="{StaticResource MutedText}"
                                                                                MaxLines="1"
                                                                                LineBreakMode="TailTruncation" />

                                                                            <Label
                                                                                Text="{Binding Reason}"
                                                                                FontSize="10"
                                                                                TextColor="{StaticResource DiamondGold}"
                                                                                MaxLines="1"
                                                                                LineBreakMode="TailTruncation" />

                                                                        </VerticalStackLayout>

                                                                        <Label
                                                                            Grid.Column="2"
                                                                            Text="▶"
                                                                            FontSize="16"
                                                                            TextColor="{StaticResource DiamondPink}"
                                                                            VerticalOptions="Center" />

                                                                    </Grid>

                                                                </Border>

                                                            </DataTemplate>

                                                        </BindableLayout.ItemTemplate>

                                                    </VerticalStackLayout>

                                                </VerticalStackLayout>

                                            </Border>

                                        </Grid>

                                    </DataTemplate>

                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                        </ScrollView>

                        <!-- Chip row -->

                        <ScrollView
                            Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Padding="17,10,17,4"
                            Background="#14FFFFFF"
                            IsVisible="{Binding AiQuickChips.Count,
                                                Converter={StaticResource CountGreaterThanZeroConverter}}">

                            <HorizontalStackLayout
                                BindableLayout.ItemsSource="{Binding AiQuickChips}"
                                Spacing="7">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate x:DataType="x:String">

                                        <Border
                                            Padding="15,8"
                                            BackgroundColor="#22FFFFFF"
                                            Stroke="#3DFFFFFF"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 21">

                                            <Border.Behaviors>
                                                <helpers:TapScaleBehavior/>
                                            </Border.Behaviors>
                                            <Border.GestureRecognizers>

                                                <TapGestureRecognizer
                                                    Tapped="OnQuickChipTapped"
                                                    CommandParameter="{Binding .}" />

                                            </Border.GestureRecognizers>

                                            <HorizontalStackLayout Spacing="6">

                                                <Label
                                                    Text="✦"
                                                    FontSize="9"
                                                    TextColor="{StaticResource DiamondGold}"
                                                    VerticalOptions="Center"
                                                    InputTransparent="True" />

                                                <Label
                                                    Text="{Binding .}"
                                                    FontSize="11.5"
                                                    FontAttributes="Bold"
                                                    CharacterSpacing="0.3"
                                                    TextColor="White"
                                                    LineBreakMode="NoWrap"
                                                    VerticalOptions="Center"
                                                    InputTransparent="True" />

                                            </HorizontalStackLayout>

                                        </Border>

                                    </DataTemplate>

                                </BindableLayout.ItemTemplate>

                            </HorizontalStackLayout>

                        </ScrollView>

                        <!-- Input Row -->

                        <Grid
                            Grid.Row="3"
                            ColumnDefinitions="*,Auto,Auto,Auto"
                            ColumnSpacing="9"
                            Padding="17,9"
                            Background="#2A0A0E22">

                            <Button
                                Grid.Column="0"
                                Text="🗑"
                                FontSize="18"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                CornerRadius="20"
                                BackgroundColor="Transparent"
                                TextColor="#A0A0A0"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                ToolTipProperties.Text="Clear Chat"
                                Command="{Binding ClearChatCommand}" />

                            <Border
                                Grid.Column="0"
                                Margin="45,0,0,0"
                                MinimumHeightRequest="50"
                                MaximumHeightRequest="120"
                                Padding="14,0"
                                BackgroundColor="#22FFFFFF"
                                Stroke="#45FFFFFF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">

                                    <Editor
                                        x:Name="AiChatEntry"
                                        Text="{Binding ChatInputText, Mode=TwoWay}"
                                        Placeholder="Ask me about TV…"
                                        PlaceholderColor="#76809F"
                                        TextColor="White"
                                        BackgroundColor="Transparent"
                                        FontSize="13"
                                        AutoSize="TextChanges"
                                        VerticalOptions="Center" />

                                    <ActivityIndicator
                                        Grid.Column="1"
                                        IsRunning="{Binding IsAiProcessingResponse}"
                                        IsVisible="{Binding IsAiProcessingResponse}"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        Color="{StaticResource DiamondGold}"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                            <Button
                                Grid.Column="1"
                                Text="🎙"
                                FontSize="18"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                CornerRadius="20"
                                BackgroundColor="#1AFFFFFF"
                                TextColor="White"
                                BorderColor="#50FFFFFF"
                                BorderWidth="1"
                                Clicked="OnAnimatedButtonClicked"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="2"
                                Text="➤"
                                FontSize="18"
                                WidthRequest="50"
                                HeightRequest="50"
                                Padding="0"
                                CornerRadius="18"
                                Background="{StaticResource DiamondBrandBrush}"
                                TextColor="White"
                                BorderColor="#70FFFFFF"
                                BorderWidth="1"
                                Clicked="OnAnimatedButtonClicked"
                                Command="{Binding SendChatMessageCommand}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

        </Border>
        </DataTemplate>

    </ContentPage.Resources>

    <ContentPage.Background>
        <StaticResource Key="PageSkyBrush" />
    </ContentPage.Background>

    <Grid RowDefinitions="*,Auto">

        <RefreshView
            Grid.Row="0"
            Command="{Binding PullToRefreshCommand}"
            IsRefreshing="{Binding IsPageRefreshing}"
            RefreshColor="{StaticResource DiamondPink}">

            <ScrollView
                VerticalScrollBarVisibility="Never"
                HorizontalScrollBarVisibility="Never"
                InputTransparent="False">

                <VerticalStackLayout
                    x:Name="ContentStack"
                    Padding="{OnIdiom Phone='15,25,15,105',
                                      Tablet='24,30,24,110',
                                      Desktop='31,30,31,115',
                                      TV='48,40,48,125'}"
                    Spacing="24"
                    MaximumWidthRequest="1550"
                    HorizontalOptions="Center">

                    <!-- Background sky diamonds -->

                    <Grid
                        HeightRequest="1"
                        InputTransparent="True">

                        <Label
                            x:Name="FloatingDiamondOne"
                            Text="◆"
                            FontSize="86"
                            TextColor="#12E8B54A"
                            Margin="-35,-45,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Start" />

                        <Label
                            x:Name="FloatingDiamondTwo"
                            Text="◇"
                            FontSize="72"
                            TextColor="#12FF4D8D"
                            Margin="0,-30,-22,0"
                            HorizontalOptions="End"
                            VerticalOptions="Start" />

                    </Grid>

                    <!-- Header -->

                    <Grid
                        x:Name="HeaderPanel"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">

                        <Border
                            Grid.Column="0"
                            WidthRequest="58"
                            HeightRequest="58"
                            Background="{StaticResource DiamondBrandBrush}"
                            Stroke="#70FFFFFF"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 19">

                            <Border.Shadow>

                                <Shadow
                                    Brush="#70E8B54A"
                                    Offset="0,6"
                                    Radius="13"
                                    Opacity="0.65" />

                            </Border.Shadow>

                            <Grid InputTransparent="True">

                                <Path
                                    Data="M12,1.6 L22.4,12 L12,22.4 L1.6,12 Z"
                                    Aspect="Uniform"
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Fill="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                                <Label
                                    Text="TV"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource DeepSky}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding GreetingMessage}"
                                FontSize="10.5"
                                FontAttributes="Bold"
                                CharacterSpacing="1.3"
                                TextTransform="Uppercase"
                                TextColor="{StaticResource DiamondBlue}" />

                            <!-- Phones are narrow enough that the 23pt greeting was
                                 clipped to "Welcome to Ma...". It wraps to a second
                                 line instead, and the phone size steps down a
                                 notch so most devices still fit on one. -->

                            <Label
                                Text="Welcome to MarkUpTV"
                                FontSize="{OnIdiom Phone=20,
                                                   Tablet=27,
                                                   Desktop=29,
                                                   TV=36}"
                                FontAttributes="Bold"
                                CharacterSpacing="0.2"
                                TextColor="White"
                                MaxLines="2"
                                LineBreakMode="WordWrap" />

                            <HorizontalStackLayout Spacing="6">

                                <Path
                                    Data="M12,1.6 L22.4,12 L12,22.4 L1.6,12 Z"
                                    Aspect="Uniform"
                                    WidthRequest="7"
                                    HeightRequest="7"
                                    Fill="{StaticResource DiamondGold}"
                                    VerticalOptions="Center" />

                                <Label
                                    Text="{Binding CurrentDate}"
                                    FontSize="11"
                                    CharacterSpacing="0.5"
                                    TextColor="{StaticResource MutedText}"
                                    VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                        <HorizontalStackLayout
                            Grid.Column="2"
                            Spacing="8"
                            VerticalOptions="Center">

                            <VerticalStackLayout
                                Spacing="0"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding CurrentTime}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource DiamondGold}"
                                    HorizontalTextAlignment="End" />

                                <Label
                                    Text="LOCAL TIME"
                                    FontSize="8"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1"
                                    TextColor="{StaticResource MutedText}" />

                            </VerticalStackLayout>

                            <Border
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="#16FFFFFF"
                                Stroke="#30FFFFFF"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16">

                                <Border.Behaviors>
                                    <helpers:TapScaleBehavior/>
                                </Border.Behaviors>
                                <Border.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Command="{Binding OpenNotificationsCommand}" />

                                </Border.GestureRecognizers>

                                <Grid
                                    InputTransparent="True"
                                    CascadeInputTransparent="True">

                                    <Path
                                        Data="M12 1 L14.4 9.6 L23 12 L14.4 14.4 L12 23 L9.6 14.4 L1 12 L9.6 9.6 Z"
                                        Aspect="Uniform"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        Fill="{StaticResource DiamondGold}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                    <Border
                                        WidthRequest="10"
                                        HeightRequest="10"
                                        Margin="0,7,7,0"
                                        BackgroundColor="{StaticResource DiamondPink}"
                                        Stroke="White"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 5"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        IsVisible="{Binding HasUnreadNotifications}" />

                                </Grid>

                            </Border>

                        </HorizontalStackLayout>

                    </Grid>

                    <!-- Search -->

                    <Border
                        x:Name="SearchPanel"
                        HeightRequest="57"
                        Padding="5,0,3,0"
                        BackgroundColor="#E70A0E22"
                        Stroke="#3CFFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 19">

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="2">

                            <!-- Vector magnifier. This was the text glyph "⌕",
                                 which renders at a different weight and optical size
                                 on every platform. -->
                            <Grid
                                Grid.Column="0"
                                WidthRequest="45"
                                InputTransparent="True">

                                <Path
                                    Data="F0 M10.6,3.4 A7.2,7.2 0 1,1 10.59,3.4 Z M10.6,5.9 A4.7,4.7 0 1,0 10.61,5.9 Z M15.7,14.3 L20.4,19 L19.1,20.3 L14.4,15.6 Z"
                                    Aspect="Uniform"
                                    WidthRequest="23"
                                    HeightRequest="23"
                                    Fill="{StaticResource DiamondBlue}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Grid>

                            <Entry
                                Grid.Column="1"
                                Text="{Binding SearchQueryText}"
                                Placeholder="Search channels, news, movies and more..."
                                PlaceholderColor="#7982A3"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                FontSize="14"
                                ReturnType="Search"
                                ReturnCommand="{Binding SearchCommand}"
                                ClearButtonVisibility="WhileEditing"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="2"
                                Text="◆"
                                Command="{Binding SearchCommand}"
                                Clicked="OnAnimatedButtonClicked"
                                WidthRequest="43"
                                HeightRequest="43"
                                Padding="0"
                                CornerRadius="14"
                                FontSize="17"
                                BackgroundColor="{StaticResource DiamondPurple}"
                                TextColor="White"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                    <!-- Quick explore -->

                    <VerticalStackLayout Spacing="11">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="1">

                                <Label
                                    Text="Explore the universe"
                                    Style="{StaticResource SectionTitleStyle}" />

                                <Label
                                    Text="Jump directly into your favourite section."
                                    Style="{StaticResource SectionCaptionStyle}" />

                            </VerticalStackLayout>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="9"
                                VerticalOptions="Center">

                                <!-- The dashboard hides the Shell nav bar, so this
                                     is the flyout's entry point. Without it the only
                                     way into the 20-item menu is an edge swipe, which
                                     Android's gesture navigation swallows as "back". -->
                                <Border
                                    x:Name="MenuEntryButton"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="#1FFFFFFF"
                                    Stroke="#45FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    SemanticProperties.Description="Open the MarkUpTV menu">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior PressedScale="0.9" />
                                    </Border.Behaviors>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOpenMenuTapped" />
                                    </Border.GestureRecognizers>

                                    <Path
                                        Data="M4,6.6 H20 M4,12 H20 M4,17.4 H20"
                                        Aspect="Uniform"
                                        WidthRequest="19"
                                        HeightRequest="19"
                                        Stroke="{StaticResource DiamondGold}"
                                        StrokeThickness="2.2"
                                        StrokeLineCap="Round"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />

                                </Border>

                                <Button
                                    Text="Search"
                                    Command="{Binding OpenSearchCommand}"
                                    Clicked="OnAnimatedButtonClicked"
                                    Style="{StaticResource GlassButtonStyle}" />

                                <!-- The assistant used to float over the feed, where
                                     it covered the right edge of whatever card was
                                     scrolled behind it. It sits in the section header
                                     now: on screen at the top of the dashboard and
                                     covering nothing. -->

                                <Border
                                    x:Name="AiEntryButton"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Background="{StaticResource DiamondBrandBrush}"
                                    Stroke="#A0FFFFFF"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 22"
                                    SemanticProperties.Description="Open the MarkUp AI assistant">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior PressedScale="0.88" />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleChatCommand}" />
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">

                                        <Path
                                            Data="M12 1 L14.4 9.6 L23 12 L14.4 14.4 L12 23 L9.6 14.4 L1 12 L9.6 9.6 Z"
                                            Aspect="Uniform"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Fill="#0B1024"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="AI"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            CharacterSpacing="1.2"
                                            TextColor="#0B1024"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                            </HorizontalStackLayout>

                        </Grid>

                        <!-- Wrap rather than scroll: as a horizontal row the
                             last chip was cut off at phone width, which reads
                             as a broken layout instead of an affordance. -->

                        <FlexLayout
                            Wrap="Wrap"
                            Direction="Row"
                            AlignItems="Start"
                            JustifyContent="Start">

                                <!-- Vector chips: the seven PNG badges this row
                                     used were mismatched stock art (a speaker for
                                     Live TV, a plain circle for Sports, a blank
                                     square for News), which read as broken icons. -->

                                <Border
                                    BackgroundColor="{StaticResource DiamondGold}"
                                    Stroke="#00FFFFFF"
                                    StrokeShape="RoundRectangle 22"
                                    HeightRequest="44"
                                    Padding="15,0"
                                    Margin="0,0,9,9">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToAllCommand}" />
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                        <Path
                                            Data="F0 M4,6.2 H20 V17.8 H4 Z M9.8,9.4 L15.4,12 L9.8,14.6 Z"
                                            Fill="#0B1024"
                                            Aspect="Uniform"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="Live TV"
                                            FontSize="12.5"
                                            FontAttributes="Bold"
                                            TextColor="#0B1024"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                                <Border
                                    BackgroundColor="#1AFFFFFF"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    HeightRequest="44"
                                    Padding="14,0"
                                    Margin="0,0,9,9">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToSportsCommand}" />
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                        <Path
                                            Data="F0 M7,3.6 H17 V9 A5,5 0 0,1 7,9 Z M10.2,14.6 H13.8 V16.6 H16.6 V20 H7.4 V16.6 H10.2 Z"
                                            Fill="{StaticResource DiamondGold}"
                                            Aspect="Uniform"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="Sports"
                                            FontSize="12.5"
                                            TextColor="White"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                                <Border
                                    BackgroundColor="#1AFFFFFF"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    HeightRequest="44"
                                    Padding="14,0"
                                    Margin="0,0,9,9">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToNewsCommand}" />
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                        <Path
                                            Data="F0 M5.4,3 H13.6 L18.6,8 V21 H5.4 Z M8.4,11.6 H15.6 V13.2 H8.4 Z M8.4,15 H15.6 V16.6 H8.4 Z"
                                            Fill="{StaticResource DiamondGold}"
                                            Aspect="Uniform"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="News"
                                            FontSize="12.5"
                                            TextColor="White"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                                <Border
                                    BackgroundColor="#1AFFFFFF"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    HeightRequest="44"
                                    Padding="14,0"
                                    Margin="0,0,9,9">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToMoviesCommand}" />
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                        <Path
                                            Data="F0 M3.4,5 H20.6 V19 H3.4 Z M5.6,6.9 H7.6 V8.9 H5.6 Z M5.6,10.6 H7.6 V12.6 H5.6 Z M5.6,14.3 H7.6 V16.3 H5.6 Z M16.4,6.9 H18.4 V8.9 H16.4 Z M16.4,10.6 H18.4 V12.6 H16.4 Z M16.4,14.3 H18.4 V16.3 H16.4 Z M9.4,7.9 H14.6 V16 H9.4 Z"
                                            Fill="{StaticResource DiamondGold}"
                                            Aspect="Uniform"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="Movies"
                                            FontSize="12.5"
                                            TextColor="White"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                                <Border
                                    BackgroundColor="#1AFFFFFF"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    HeightRequest="44"
                                    Padding="14,0"
                                    Margin="0,0,9,9">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToMusicCommand}" />
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                        <Path
                                            Data="M19,2.6 V15.4 A2.9,2.9 0 1,1 16.9,12.7 V7.3 L10,8.9 V17.4 A2.9,2.9 0 1,1 7.9,14.7 V5 Z"
                                            Fill="{StaticResource DiamondGold}"
                                            Aspect="Uniform"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="Music"
                                            FontSize="12.5"
                                            TextColor="White"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                                <Border
                                    BackgroundColor="#1AFFFFFF"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    HeightRequest="44"
                                    Padding="14,0"
                                    Margin="0,0,9,9">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToSocialCommand}" />
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                        <Path
                                            Data="M4,4.4 H20 V15.4 H11.4 L6.4,19.6 V15.4 H4 Z"
                                            Fill="{StaticResource DiamondGold}"
                                            Aspect="Uniform"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="Community"
                                            FontSize="12.5"
                                            TextColor="White"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                                <Border
                                    BackgroundColor="#1AFFFFFF"
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    HeightRequest="44"
                                    Padding="14,0"
                                    Margin="0,0,9,9">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToDonationCommand}" />
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                        <Path
                                            Data="M12,20.4 C6.2,15.8 3.2,12.6 3.2,9.2 A4.5,4.5 0 0,1 12,6.8 A4.5,4.5 0 0,1 20.8,9.2 C20.8,12.6 17.8,15.8 12,20.4 Z"
                                            Fill="{StaticResource DiamondGold}"
                                            Aspect="Uniform"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="Support"
                                            FontSize="12.5"
                                            TextColor="White"
                                            VerticalOptions="Center" />

                                    </HorizontalStackLayout>

                                </Border>

                        </FlexLayout>

                    </VerticalStackLayout>

                    <!-- Feature grid -->

                    <FlexLayout
                        BindableLayout.ItemsSource="{Binding PrimaryFeatures}"
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Start"
                        JustifyContent="Start">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:DashboardFeature">

                                <Border
                                    WidthRequest="{OnIdiom Phone=158,
                                                           Tablet=184,
                                                           Desktop=205,
                                                           TV=245}"
                                    HeightRequest="{OnIdiom Phone=122,
                                                            Tablet=127,
                                                            Desktop=132,
                                                            TV=151}"
                                    Margin="0,0,11,11"
                                    Padding="13"
                                    Style="{StaticResource DiamondCardStyle}">

                                    <Border.Behaviors>
                                        <helpers:TapScaleBehavior/>
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>

                                        <TapGestureRecognizer
                                            Tapped="OnDashboardFeatureCardTapped"
                                            CommandParameter="{Binding .}" />

                                    </Border.GestureRecognizers>

                                    <Border.Shadow>

                                        <Shadow
                                            Brush="#57000000"
                                            Offset="0,6"
                                            Radius="11"
                                            Opacity="0.48" />

                                    </Border.Shadow>

                                    <Grid
                                        InputTransparent="True"
                                        CascadeInputTransparent="True"
                                        RowDefinitions="Auto,*"
                                        RowSpacing="6">

                                        <Border
                                            WidthRequest="{OnIdiom Phone=37, Tablet=41, Desktop=47, TV=58}"
                                            HeightRequest="{OnIdiom Phone=37, Tablet=41, Desktop=47, TV=58}"
                                            Padding="0"
                                            BackgroundColor="#16FFFFFF"
                                            Stroke="#32FFFFFF"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            HorizontalOptions="Start">

                                            <!-- Same vector set as the quick-explore
                                                 chips; the token bound here used to be
                                                 a full-colour emoji. -->

                                            <Path
                                                Data="{Binding Icon, Converter={StaticResource FeatureIcon}}"
                                                Fill="{StaticResource DiamondGold}"
                                                Aspect="Uniform"
                                                WidthRequest="{OnIdiom Phone=19, Tablet=21, Desktop=25, TV=31}"
                                                HeightRequest="{OnIdiom Phone=19, Tablet=21, Desktop=25, TV=31}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />

                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Row="1"
                                            Spacing="3"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Title}"
                                                FontSize="{OnIdiom Phone=15,
                                                                   Tablet=16,
                                                                   Desktop=16,
                                                                   TV=19}"
                                                FontAttributes="Bold"
                                                TextColor="White"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation" />

                                            <!-- Caption and CTA share one row: as a third
                                                 grid row the CTA was pushed onto the caption
                                                 (the card is shorter than icon + two lines +
                                                 CTA), which is what printed "Open" across the
                                                 subtitle. -->

                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="6">

                                                <Label
                                                    Text="{Binding Subtitle}"
                                                    FontSize="{OnIdiom Phone=11,
                                                                       Tablet=12,
                                                                       Desktop=12,
                                                                       TV=14}"
                                                    TextColor="{StaticResource MutedText}"
                                                    MaxLines="1"
                                                    LineBreakMode="TailTruncation"
                                                    VerticalOptions="Center" />

                                                <HorizontalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="3">

                                                    <Label
                                                        Text="Open"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource DiamondGold}"
                                                        VerticalOptions="Center" />

                                                    <Label
                                                        Text="›"
                                                        FontSize="14"
                                                        TextColor="{StaticResource DiamondGold}"
                                                        VerticalOptions="Center" />

                                                </HorizontalStackLayout>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </FlexLayout>

                    <!-- Featured hero -->

                    <Border
                        x:Name="HeroPanel"
                        IsVisible="{Binding HasFeaturedContent}"
                        HeightRequest="{OnIdiom Phone=280,
                                                Tablet=320,
                                                Desktop=355,
                                                TV=420}"
                        Background="{StaticResource HeroBrush}"
                        Stroke="#45FFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28">

                        <Border.Behaviors>
                            <helpers:TapScaleBehavior/>
                        </Border.Behaviors>
                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding GoToFeaturedCommand}" />

                        </Border.GestureRecognizers>

                        <Border.Shadow>

                            <Shadow
                                Brush="#85000000"
                                Offset="0,11"
                                Radius="21"
                                Opacity="0.72" />

                        </Border.Shadow>

                        <Grid IsClippedToBounds="True">

                            <Image
                                Source="{Binding FeaturedImageUrl}"
                                Aspect="AspectFill"
                                Opacity="0.37"
                                InputTransparent="True" />

                            <BoxView
                                Color="#080A19"
                                Opacity="0.44"
                                InputTransparent="True" />

                            <Label
                                Text="◆"
                                FontSize="110"
                                TextColor="#18FFFFFF"
                                Margin="0,-20,-20,0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                InputTransparent="True" />

                            <Grid
                                InputTransparent="True"
                                CascadeInputTransparent="True"
                                Padding="{OnIdiom Phone=21,
                                                  Tablet=27,
                                                  Desktop=32,
                                                  TV=43}"
                                RowDefinitions="Auto,*,Auto">

                                <Border
                                    Padding="11,5"
                                    BackgroundColor="#2AE8B54A"
                                    Stroke="#56E8B54A"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    HorizontalOptions="Start">

                                    <HorizontalStackLayout Spacing="6">

                                        <Path
                                            Data="M12,1.6 L22.4,12 L12,22.4 L1.6,12 Z"
                                            Aspect="Uniform"
                                            WidthRequest="8"
                                            HeightRequest="8"
                                            Fill="{StaticResource DiamondGold}" />

                                        <Label
                                            Text="{Binding FeaturedCategory}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            CharacterSpacing="1"
                                            TextColor="{StaticResource DiamondBlue}" />

                                    </HorizontalStackLayout>

                                </Border>

                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Spacing="7"
                                    VerticalOptions="End">

                                    <Label
                                        Text="{Binding FeaturedTitle}"
                                        FontSize="{OnIdiom Phone=28,
                                                           Tablet=35,
                                                           Desktop=41,
                                                           TV=53}"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        MaxLines="2"
